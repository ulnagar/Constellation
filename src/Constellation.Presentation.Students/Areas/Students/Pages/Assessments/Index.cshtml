@page
@using Constellation.Core.Models.Assessments.Enums
@model Constellation.Presentation.Students.Areas.Students.Pages.Assessments.IndexModel
@{
}

<h2>Assessments</h2>

@foreach (var group in Model.Assessments.OrderBy(entry => entry.Key.EndDate))
{
    <h3>@group.Key.Description</h3>

    foreach (var assessment in group.Value.OrderBy(entry => entry.DueDate).ThenBy(entry => entry.Course))
    {
        var collapseId = $"A-{assessment.Id}";

        <div class="row p-2 mx-1 my-2 position-relative border border-2 rounded-3">
            <div class="position-relative p-2">
                <span class="row d-flex align-items-center">
                    <div class="col-auto">
                        <a class="collapse-toggle text-decoration-none text-reset d-flex align-items-center gap-2" data-bs-toggle="collapse" href="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <i class="fas fa-chevron-right chevron-icon"></i>
                        </a>
                    </div>
                    <div class="col">
                        <h4>@assessment.Course: @assessment.Name</h4>
                    </div>
                    <div class="col-auto upload-wrapper" style="display:none">
                        <a asp-page="/Assessments/Upload" asp-area="Students" asp-route-assessmentId="@assessment.Id" class="btn btn-success">Upload File</a>
                    </div>
                </span>
            </div>
        
            <div class="collapse" id="@collapseId">
                <span class="mt-3">
                    <dl>
                        <dt>Due Date:</dt>
                        <dd>@assessment.DueDate.LocalDateTime.ToString("D")</dd>

                        <dt>Hidden Date:</dt>
                        <dd>@assessment.AvailableTo.LocalDateTime.ToString("D")</dd>
                    </dl>
                </span>

                <span class="mt-3">
                    <div class="accordion accordion-flush" id="accordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#provisions-@collapseId" aria-expanded="false" aria-controls="provisions">
                                    Student Provisions
                                </button>
                            </h2>
                            <div id="provisions-@collapseId" class="accordion-collapse collapse" data-bs-parent="#accordion">
                                <div class="accordion-body">
                                    @foreach (var student in assessment.Students.OrderBy(entry => entry.StudentName.SortOrder))
                                    {
                                        <h6>@student.StudentName</h6>
                                        <ul>
                                            @if (student.Provisions.Count == 0)
                                            {
                                                <li>None</li>
                                            }
                                            else
                                            {
                                                foreach (var provision in student.Provisions)
                                                {
                                                    <li>@provision</li>
                                                }
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#instructions-@collapseId" aria-expanded="false" aria-controls="instructions">
                                    Instructions
                                </button>
                            </h2>
                            <div id="instructions-@collapseId" class="accordion-collapse collapse" data-bs-parent="#accordion">
                                <div class="accordion-body">
                                    @Html.Raw(assessment.Instructions.FirstOrDefault(entry => entry.Category == UserCategory.Student)?.Description ?? "<h4>None</h4>")
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fs-5" type="button" data-bs-toggle="collapse" data-bs-target="#downloads-@collapseId" aria-expanded="false" aria-controls="downloads">
                                    Downloads
                                </button>
                            </h2>
                            <div id="downloads-@collapseId" class="accordion-collapse collapse" data-bs-parent="#accordion">
                                <div class="accordion-body">
                                    @foreach (var download in assessment.Downloads)
                                    {
                                        @if (download.IsRestricted)
                                            continue;

                                        <div class="p-2 ms-1 me-1 mb-2 position-relative border border-2 rounded-3">
                                            <span class="row d-flex align-items-center">
                                                <div class="col">
                                                    <div class="h4">@download.Name</div>
                                                </div>
                                                <div class="fa-icon-sizing">
                                                    <a asp-page-handler="DownloadFile" asp-route-downloadId="@download.DownloadId" asp-route-assessmentId="@assessment.Id" class="stretched-link">
                                                        <i class="fad fa-file-download fa-3x app-theme"></i>
                                                    </a>
                                                </div>
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </span>
            </div>
        </div>
    }

    <hr />
}

@section Scripts
{
    <script>
        document.querySelectorAll('.collapse[id^="A-"]').forEach(function (collapseEl) {
            var uploadWrapper = collapseEl.previousElementSibling.querySelector('.upload-wrapper');

            collapseEl.addEventListener('show.bs.collapse', function (e) {
                if (e.target !== collapseEl) return;
                uploadWrapper.style.display = '';
            });

            collapseEl.addEventListener('hide.bs.collapse', function (e) {
                if (e.target !== collapseEl) return;
                uploadWrapper.style.display = 'none';
            });
        });
    </script>
}
