@page
@using Constellation.Core.Models.Tutorials.Enums
@model Constellation.Presentation.Students.Areas.Students.Pages.Tutorials.IndexModel

<h2>Tutorial and Study Support</h2>

<div class="d-flex flex-row mt-3 mb-3 page-menu">
    <a asp-page="/Tutorials/Request" asp-area="Students" class="btn btn-primary">New Request</a>
</div>

<hr />

<div class="d-sm-flex flex-column mt-1">
    
    <div class="accordion" id="accordion">

        <div class="accordion-item">
            <h2 class="accordion-header" id="accordion-header-requests">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accordion-item-requests" aria-expanded="false" aria-controls="accordion-item-request">
                    <h5 class="position-relative p-1">
                        Requests
                        @if (Model.Requests.Count > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@Model.Requests.Count</span>
                        }
                    </h5>
                </button>
            </h2>
            <div id="accordion-item-requests" class="accordion-collapse" aria-labelledby="accordion-header-requests" data-bs-parent="#accordion">
                <div class="accordion-body">
                    <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 g-4 mb-3">
                        @foreach (var request in Model.Requests)
                        {
                            var cardStyle = request.Status switch
                            {
                                _ when request.Status == RequestStatus.Approved => "text-white bg-success",
                                _ when request.Status == RequestStatus.Rejected => "text-white bg-danger",
                                _ when request.Status == RequestStatus.Requested => "text-dark bg-light"
                            };

                            <div class="col">
                                <div class="card m-3 float-start h-100 @cardStyle">
                                    <h4 class="card-header">@request.Type - @request.Status</h4>
                                    <div class="card-body">
                                        <h5 class="card-subtitle mb-3">Request Details</h5>

                                        <dl class="mb-2">
                                            @if (request.Type == TutorialType.Subject)
                                            {
                                                <dt>Course</dt>
                                                <dd>@request.Course</dd>
                                            }

                                            <dt>Periods</dt>
                                            <dd>
                                                @foreach (var period in request.Periods.OrderBy(period => period.SortOrder))
                                                {
                                                    <ul class="list-group">
                                                        <li class="list-group-item">
                                                            @period.ToString()
                                                        </li>
                                                    </ul>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="accordion-item">
            <h2 class="accordion-header" id="accordion-header-tutorials">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accordion-item-tutorials" aria-expanded="false" aria-controls="accordion-item-tutorials">
                    <h5 class="position-relative p-1">
                        Tutorials
                        @if (Model.Tutorials.Count > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning">@Model.Tutorials.Count</span>
                        }
                    </h5>
                </button>
            </h2>
            <div id="accordion-item-tutorials" class="accordion-collapse collapse" aria-labelledby="accordion-header-tutorials" data-bs-parent="#accordion">
                <div class="accordion-body">
                
                    <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 g-4">
                        @foreach (var tutorial in Model.Tutorials.OrderBy(entry => entry.Start))
                        {
                            <div class="col">
                                <div class="card m-3 float-start h-100">
                                    <h4 class="card-header">@tutorial.Name</h4>
                                    <div class="card-body">
                                        <dl class="mb-2">
                                            <dt>Start</dt>
                                            <dd>@tutorial.Start</dd>
                                            
                                            <dt>End</dt>
                                            <dd>@tutorial.End</dd>

                                            <dt>Teachers</dt>
                                            <dd>
                                                @foreach (var teacher in tutorial.Teachers.OrderBy(entry => entry.SortOrder))
                                                {
                                                    <ul class="list-group">
                                                        <li class="list-group-item">
                                                            @teacher.DisplayName
                                                        </li>
                                                    </ul>
                                                }
                                            </dd>

                                            <dt>Periods</dt>
                                            <dd>
                                                @foreach (var period in tutorial.Periods.OrderBy(period => period.SortOrder))
                                                {
                                                    <ul class="list-group">
                                                        <li class="list-group-item">
                                                            @period.ToString()
                                                        </li>
                                                    </ul>
                                                }
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>