@page
@using Constellation.Core.Models.Tutorials.Enums
@model Constellation.Presentation.Students.Areas.Students.Pages.Tutorials.RequestModel

<div class="d-grid gap-2 d-block d-sm-block d-md-block d-lg-none d-xl-none d-xxl-none my-1">
    <a asp-page="/Attendance/Index" asp-area="Students" class="btn btn-primary">Go Back</a>
</div>

<div class="d-none d-lg-block d-xl-block d-xxl-block my-1">
    <a asp-page="/Attendance/Index" asp-area="Students" class="btn btn-primary">Go Back</a>
</div>

<h2>Tutorial and Study Support</h2>

<div class="d-sm-flex flex-column flex-lg-row border-bottom mt-1">
    <div class="mb-2 col-md-2">
        <strong>Tutorial Type</strong>
    </div>
    <div class="mb-2 col-md-10">
        <span></span>
    </div>
</div>

<div class="d-flex flex-column flex-lg-row justify-content-around mt-3">
    <div class="position-relative cursor-pointer border border-secondary rounded p-3 mb-3 h-100 text-center @(Model.Type == TutorialType.Subject ? "selected" : "unselected")">
        <a href="#" class="stretched-link" onclick="selectType('subject')"></a>
        <div>Subject Support</div>
    </div>

    <div class="position-relative cursor-pointer border border-secondary rounded p-3 mb-3 h-100 text-center @(Model.Type == TutorialType.Study ? "selected" : "unselected")">
        <a href="#" class="stretched-link" onclick="selectType('study')"></a>
        <div>Study Support</div>
    </div>
</div>

    

    

    
