            /* ── Ghost error code ── */
            .cns-error__ghost {
                position: absolute;
                right: -0.04em;
                top: 50%;
                transform: translateY(-50%);
                font-size: clamp(120px, 22vw, 240px);
                font-weight: 700;
                color: rgba(255, 255, 255, 0.026);
                line-height: 1;
                letter-spacing: -0.05em;
                pointer-events: none;
                user-select: none;
            }

                .cns-error__ghost > img {
                    opacity: 0.26;
                    filter: saturate(0.5);
                }

            /* ── Navigation ── */
            .cns-error__nav {
                position: relative;
                z-index: 1;
                padding: 0.875rem 1.5rem;
                border-bottom: 0.5px solid var(--cns-border);
                display: flex;
                align-items: center;
            }

            .cns-error__brand {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                color: rgba(255, 255, 255, 0.9);
                text-decoration: none;
                font-size: 1.5rem;
                font-weight: 500;
                letter-spacing: -0.2px;
            }

                .cns-error__brand > img {
                    height: 35px;
                    width: 35px;
                }

                .cns-error__brand:hover {
                    color: #fff;
                }

            /* ── Main content ── */
            .cns-error__main {
                position: relative;
                z-index: 1;
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2.5rem 1.5rem;
            }

            .cns-error__content {
                text-align: center;
                max-width: 440px;
            }

            /* ── Status badge ── */
            .cns-error__badge {
                display: inline-flex;
                align-items: center;
                gap: 0.375rem;
                border-radius: 2rem;
                padding: 0.25rem 0.75rem;
                font-size: 1.2rem;
                font-weight: 500;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                margin-bottom: 1.25rem;
                background: var(--cns-accent-glow);
                border: 0.5px solid var(--cns-accent-border);
                color: var(--cns-accent-light);
            }

            /* Badge variants — driven by data-error on body */
            [data-error="403"] .cns-error__badge {
                background: rgba(202, 138, 4, 0.09);
                border-color: rgba(202, 138, 4, 0.28);
                color: #CA8A04;
            }

            [data-error="500"] .cns-error__badge {
                background: rgba(239, 68, 68, 0.09);
                border-color: rgba(239, 68, 68, 0.28);
                color: #F87171;
            }

            [data-error="503"] .cns-error__badge {
                background: rgba(139, 92, 246, 0.09);
                border-color: rgba(139, 92, 246, 0.28);
                color: #A78BFA;
            }

            /* ── Heading ── */
            .cns-error__title {
                font-size: 2.5rem;
                font-weight: 500;
                color: var(--cns-text);
                margin: 0 0 0.75rem;
                line-height: 1.5;
            }

            .cns-error__desc {
                font-size: 1.25rem;
                color: var(--cns-muted);
                line-height: 1.75;
                margin: 0 0 1.75rem;
            }

            /* ── Action buttons ── */
            .cns-error__actions {
                display: flex;
                gap: 0.625rem;
                justify-content: center;
                flex-wrap: wrap;
            }

            .cns-error__btn-primary {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                background: var(--cns-accent);
                color: #fff !important;
                border: none;
                padding: 0.5rem 1.125rem;
                border-radius: 0.375rem;
                font-size: 1rem;
                font-weight: 500;
                text-decoration: none;
                letter-spacing: -0.1px;
                transition: background 0.15s ease;
            }

                .cns-error__btn-primary:hover {
                    background: var(--cns-accent-hover);
                }

            .cns-error__btn-ghost {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                background: transparent;
                color: rgba(255, 255, 255, 0.45) !important;
                border: 0.5px solid rgba(255, 255, 255, 0.11);
                padding: 0.5rem 1.125rem;
                border-radius: 0.375rem;
                font-size: 1rem;
                font-weight: 400;
                text-decoration: none;
                transition: border-color 0.15s ease, color 0.15s ease;
            }

                .cns-error__btn-ghost:hover {
                    border-color: rgba(255, 255, 255, 0.22);
                    color: rgba(255, 255, 255, 0.65) !important;
                }

            /* -- Support Details -- */
            .cns-error__details{
                margin-top: 0.75rem;
            }

            /* ── Support / request ID note ── */
            /* Shown automatically for 500 and 503 via data-error selector */
            .cns-error__ref {
                display: none;
            }

            [data-error="500"] .cns-error__ref,
            [data-error="503"] .cns-error__ref {
                display: block;
                font-size: 0.75rem;
                color: var(--cns-muted);
                margin-top: 0.75rem;
            }

            .cns-error__ref code {
                background: rgba(255, 255, 255, 0.06);
                color: #6B7FA8;
                padding: 1px 6px;
                border-radius: 3px;
                font-size: 0.6875rem;
            }

            /* ── Failing URL ── */
            /* Shown whenever Model.FailingUrl is non-null, for any error code */
            .cns-error__failing-url {
                display: none;
            }

            [data-has-url="True"] .cns-error__failing-url {
                display: block;
                font-size: 0.75rem;
                color: var(--cns-muted);
                margin-top: 0.75rem;
            }

            .cns-error__failing-url code {
                background: rgba(255, 255, 255, 0.06);
                color: #6B7FA8;
                padding: 1px 6px;
                border-radius: 3px;
                font-size: 0.6875rem;
                word-break: break-all;
            }

            /* ── Footer ── */
            .cns-error__footer {
                position: relative;
                z-index: 1;
                padding: 0.8rem 1.5rem;
                border-top: 0.5px solid var(--cns-border-subtle);
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 0.5rem;
            }

            .cns-error__footer-copy {
                font-size: 1rem;
                /* color: var(--cns-footer); */
                color: var(--cns-text);
            }

            .cns-error__footer a {
                font-size: 1rem;
                color: var(--cns-accent);
                text-decoration: none;
            }

                .cns-error__footer a:hover {
                    color: var(--cns-accent-light);
                }
    </style>
</head>

<body class="cns-error" data-error="@Model.StatusCode" data-has-url="@(Model.FailingUrl is not null)">

    <!-- Atmospheric background layers (decorative, hidden from AT) -->
    <div class="cns-error__bg" aria-hidden="true"></div>
    <div class="cns-error__stars" aria-hidden="true"></div>

    <!-- Ghost error code watermark (decorative) -->
    <div class="cns-error__ghost" aria-hidden="true"><img src="~/logo.svg" /> @Model.StatusCode</div>

    <!-- ── Navigation ── -->
    <nav class="cns-error__nav" aria-label="Application">
        <a href="/" class="cns-error__brand">
            <img src="~/logo.svg" />
            Constellation
        </a>
    </nav>

    <!-- ── Main error content ── -->
    <main class="cns-error__main" id="main-content">
        <div class="cns-error__content">

            <!-- Status badge -->
            <div class="cns-error__badge" role="status" aria-live="polite">
                <svg width="7" height="7" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
                    <circle cx="5" cy="5" r="5" />
                </svg>
                @Model.BadgeText
            </div>

            <!-- Title -->
            <h1 class="cns-error__title">@Model.Title</h1>

            <!-- Description -->
            <p class="cns-error__desc">@Model.Description</p>

            <!-- Actions -->
            <div class="cns-error__actions">
                <a href="/" class="cns-error__btn-primary">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    Dashboard
                </a>
                <a href="javascript:history.back()" class="cns-error__btn-ghost">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="19" y1="12" x2="5" y2="12" />
                        <polyline points="12 19 5 12 12 5" />
                    </svg>
                    Go back
                </a>
            </div>

            <div class="cns-error__details">
                <p class="cns-error__desc">Our team has been notified.</p>
    
                <!-- Support reference (rendered for 500/503 via CSS data-error selector) -->
                <p class="cns-error__ref">
                    Reference: <code>@Model.RequestId</code>
                </p>

                <!-- Failing URL (rendered whenever FailingUrl is available) -->
                <p class="cns-error__failing-url">
                    Occurred on: <code>@Model.FailingUrl</code>
                </p>
            </div>
            

        </div>
    </main>

    <!-- ── Footer ── -->
    <footer class="cns-error__footer">
        <span class="cns-error__footer-copy">Aurora College - Constellation</span>
        <a href="mailto:support@aurora.nsw.edu.au">Contact support</a>
    </footer>

</body>
</html>