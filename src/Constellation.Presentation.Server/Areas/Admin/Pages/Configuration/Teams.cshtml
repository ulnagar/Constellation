@page
@model Constellation.Presentation.Server.Areas.Admin.Pages.Configuration.TeamsModel
@using Constellation.Core.Enums
@using Constellation.Core.Extensions
@{
}

<h2>Teams Configuration</h2>

<div class="page-menu">
    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />

@* ReSharper disable Mvc.PartialViewNotResolved *@
<form method="post">
    <partial name="ConfigurationStaffCardList" model='("Mandatory Owners", "MandatoryOwners", "mandatory-owners", "StaffListModal--Mandatory-Owners", @Model.MandatoryOwners, @Model.StaffMembers)'/>
    
    <hr />
    
    <partial name="ConfigurationStaffCardList" model='("Student Team Owners", "StudentTeamOwners", "team-owners", "StaffListModal--Team-Owners", @Model.StudentTeamOwners, @Model.StaffMembers)' />

    <hr />
    
    <partial name="ConfigurationStaffCardList" model='("Student Team Channel Owners", "StudentChannelOwners", "channel-owners", "StaffListModal--Channel-Owners", @Model.StudentChannelOwners, @Model.StaffMembers)' />

    <div class="my-3 row">
        <div class="col-md-3 d-grid">
            <input asp-page-handler="Save" type="submit" value="Save" class="btn btn-success btn-lg" />
        </div>
    </div>
</form>

<partial name="ConfigurationStaffModal" model='("StaffListModal--Mandatory-Owners", "MandatoryOwners", ".staff-member-card-container--mandatory-owners", @Model.StaffMembers)' />
<partial name="ConfigurationStaffModal" model='("StaffListModal--Team-Owners", "StudentTeamOwners", ".staff-member-card-container--team-owners", @Model.StaffMembers)' />
<partial name="ConfigurationStaffModal" model='("StaffListModal--Channel-Owners", "StudentChannelOwners", ".staff-member-card-container--channel-owners", @Model.StaffMembers)' />
@* ReSharper restore Mvc.PartialViewNotResolved *@

<template id="staff-member-card">
    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-11">
                        <h5 class="card-title"></h5>
                        <h6 class="card-subtitle"></h6>

                        <input type="hidden" name=".index" value="" />
                        <input type="hidden" name="[].Key" value="" />
                    </div>
                    <div class="col-1">
                        <button type="button" class="btn-close" aria-label="Close"></button>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                @foreach (var grade in Enum.GetValues<Grade>().OrderBy(grade => grade))
                {
                    if (grade == Grade.SpecialProgram)
                        continue;

                    <button type="button" class="btn btn-outline-secondary mb-1 grade-toggle-button" data-property-name="" data-key="" data-grade-name="@grade" data-grade-number="@((int)grade)">@grade.AsName()</button>
                }
            </div>
        </div>
    </div>
</template>

@section scripts {
    <script>
        $('.modal').on('shown.bs.modal', function() {
            const $modal = $(this);
            const $scope = $($(this).data('search-scope'));

            $modal.find('option').each(function () {
                const value = $(this).val();
                if($scope.find('input[name*="' + value + '"]').length) {
                    $(this).prop('disabled', true);
                }
            });

            $(this).find('select').select2({
                theme: 'bootstrap-5',
                dropdownParent: $(this)
            });
        });

        $('.row').on('click', '.btn-close', function() {
            const button = $(this);
            const container = button.closest('.col');

            document.startViewTransition(() => {
                container.remove();
            });
        });

        $('.row').on('click', '.grade-toggle-button', function() {
            const button = $(this);

            const staffId = button.data('key');
            const gradeName = button.data('gradeName');
            const gradeNumber = button.data('gradeNumber');
            const propertyName = button.data('propertyName');

            if (button.hasClass('btn-primary'))
            {
                // Currently selected, remove
                const indexInput = $('input[name="' + propertyName + '[' + staffId + '].Value.index"][value="' + gradeName + '"]');
                const valueInput = $('input[name="' + propertyName + '[' + staffId + '].Value[' + gradeName + ']"]');

                indexInput.remove();
                valueInput.remove();

                button.removeClass('btn-primary');
                button.addClass('btn-outline-secondary');
            }
            else
            {
                // Currently not selected, add
                const indexInput = $('<input>')
                    .attr('type', "hidden")
                    .attr('name', propertyName + '[' + staffId + '].Value.index');
                indexInput.val(gradeName);
                const valueInput = $('<input>')
                    .attr('type', "hidden")
                    .attr('name', propertyName + '[' + staffId + '].Value[' + gradeName + ']');
                valueInput.val(gradeNumber);

                button.after(valueInput);
                button.after(indexInput);

                button.removeClass('btn-outline-secondary');
                button.addClass('btn-primary');
            }
        });

        $('.modal .modal-save-button').on('click', function() {
            const $modal = $(this).closest('.modal');
            const propertyName = $modal.data('property-name');
            const container = $modal.data('search-scope');
            const $select = $modal.find('select');

            const staffId = $select.val();
            const staffName = $select.find('option:selected').text();
            const staffEmail = $select.find('option:selected').data('email');

            if ($('[name="' + propertyName + '[' + staffId + '].Key"]').length === 0) {
                const template = $('#staff-member-card').contents().clone();
                template.find('.card-title').text(staffName);
                template.find('.card-subtitle').text(staffEmail);
                template.find('[name=".index"]').attr('name', propertyName + '.index').val(staffId);
                template.find('[name="[].Key"]').attr('name', propertyName + '[' + staffId + '].Key').val(staffId);
                template.find('.grade-toggle-button').attr('data-key', staffId).attr('data-property-name', propertyName);

                document.startViewTransition(() => {
                    $(container).append(template);
                });
            }

            bootstrap.Modal.getInstance($modal[0]).hide();
            $select.val('');
        });
    </script>
}
