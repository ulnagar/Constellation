@page "{id:guid}"
@model Constellation.Presentation.Server.Areas.Admin.Pages.Auth.Roles.DetailsModel

@using Constellation.Application.Extensions
@using Constellation.Application.Models.Auth
@using Constellation.Application.Models.Identity.Enums
@using Constellation.Infrastructure.Identity.Authorization
@using Microsoft.AspNetCore.Authorization

@inject IAuthorizationService AuthorizationService

@{
    Layout = "/Areas/Admin/Pages/_AdminLayout.bs5.cshtml";

    IAuthorizationRequirement permissionRequirement = new PermissionRequirement([AuthPermission.Admin_Authentication_Edit]);

    var canEdit = await AuthorizationService.AuthorizeAsync(User, null, permissionRequirement);
}

<h3>Role Management</h3>

<div class="page-menu">
    @if (canEdit.Succeeded)
    {
        <a asp-page="/Auth/Roles/Upsert" asp-area="Admin" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    }

    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />


<div>
    <dl class="row">
        <dt class="col-md-2">
            <label asp-for="RoleDetails.Id">Role Id</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.RoleDetails.Id</span>
        </dd>

        <dt class="col-md-2">
            <label asp-for="RoleDetails.Name">Name</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.RoleDetails.Name</span>
        </dd>

        <dt class="col-md-2">
            <label asp-for="RoleDetails.Type">Role Type</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.RoleDetails.Type</span>
        </dd>
    </dl>
</div>

<hr />

<div>
    <nav class="navbar navbar-expand-xl navbar-toggleable-xl navbar-dark bg-success bg-gradient local-nav">
        <div class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
            <ul class="nav navbar-nav flex-grow-1 me-auto ms-3 mb-2">
                <li class="nav-item">
                    <a class="nav-link active" href="#users" data-bs-toggle="tab" role="tab">Users</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#permissions" data-bs-toggle="tab" role="tab">Permissions</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="tab-content">
        <div id="users" class="tab-pane active">
            <h3>Users</h3>

            <button data-bs-toggle="modal" data-bs-target="#addUserModal" class="btn btn-warning">Add User</button>

            <table class="table table-striped table-hover users-data-table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Links</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model.RoleDetails.Users)
                {
                    <tr>
                        <td data-order="@entry.UserName.SortOrder" data-search="@entry.UserName.DisplayName @entry.UserName.FirstName">@entry.UserName</td>
                        <td>@entry.Email</td>
                        <td>
                            @foreach (var link in entry.Links)
                            {
                                if (link.Type == LinkType.Staff)
                                {
                                    <a asp-page="/Partner/Staff/Details" asp-area="Staff" asp-route-id="@link.LinkId" class="badge bg-primary link-underline link-underline-opacity-0" tooltip="Id: @link.LinkId">Staff</a>
                                }

                                if (link.Type == LinkType.Student)
                                {
                                    <a asp-page="/Partner/Students/Details" asp-area="Staff" asp-route-id="@link.LinkId" class="badge bg-primary link-underline link-underline-opacity-0" tooltip="Id: @link.LinkId">Student</a>
                                }

                                if (link.Type == LinkType.Contact)
                                {
                                    <a asp-page="/Partner/Schools/Contacts/Details" asp-area="Staff" asp-route-id="@link.LinkId" class="badge bg-primary link-underline link-underline-opacity-0" tooltip="Id: @link.LinkId">Contact</a>
                                }

                                if (link.Type == LinkType.Family)
                                {
                                    <a asp-page="/Partner/Students/Families/Details" asp-area="Staff" asp-route-id="@link.LinkId" class="badge bg-primary link-underline link-underline-opacity-0" tooltip="Id: @link.LinkId">Family</a>
                                }

                                if (link.Type == LinkType.Parent)
                                {
                                    <span class="badge bg-primary" tooltip="Id: @link.LinkId">Parent</span>
                                }
                            }
                        </td>
                        <td>
                            <a asp-page-handler="RemoveUser" asp-route-userId="@entry.Id" class="btn btn-warning btn-sm btn-show-hover">Remove</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        
        <div id="permissions" class="tab-pane">
            <h3>Permissions</h3>

            <button data-bs-toggle="modal" data-bs-target="#addPermissionModal" class="btn btn-warning">Add Permission</button>
            <a asp-page="/Auth/Rols/ManagePermissions" asp-area="Admin" asp-route-id="@Model.Id" class="btn btn-warning">Bulk Add Permissions</a>

            @{
                var list = Model.RoleDetails.Permissions.OrderBy(entry => entry.Value).Partition(Model.RoleDetails.Permissions.Count / 3);

                <div class="row">
                    @foreach (var group in list)
                    {
                        <div class="col-md-4 list-group">
                            @foreach (var item in group)
                            {
                                <div class="d-flex w-100 justify-content-between list-group-item">
                                    <span class="mb-1">@item.Name</span>
                                    <a asp-page-handler="RemovePermission" asp-route-permission="@item.Value" class="btn-close btn-show-hover"></a>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>


<vc:role-add-user role-id="@Model.Id" />
<vc:role-add-permission role-id="@Model.Id" />

@section scripts
{
    <script>
        $(document).ready(function (){
            $('.users-data-table').DataTable({
                "order": [
                    [0, 'asc']
                ]
            });
        });
    </script>
}