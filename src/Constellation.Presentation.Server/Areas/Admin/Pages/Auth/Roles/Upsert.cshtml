@page "{id?}"
@model Constellation.Presentation.Server.Areas.Admin.Pages.Auth.Roles.UpsertModel

<h2>@(Model.Id == Guid.Empty ? "New Role" : "Edit Role")</h2>

<div class="page-menu">
    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />

<form method="post">
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3 row">
            <label asp-for="Name" class="col-md-2">Role Name</label>
            <div class="col-md-3">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="Type" class="col-md-2">Role Type</label>
            <div class="col-md-3">
                <select asp-for="Type" class="combo w-100">
                    <option value=""> -- Select -- </option>
                    @foreach (var entry in Model.RoleTypes)
                    {
                        <option value="@entry.Value">@entry.Name</option>
                    }
                </select>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        
        <div class="mb-3">
            <div class="col-md-offset-2 col-md-3 d-grid">
                <input type="submit" value="Save" class="btn btn-primary btn-lg"/>
            </div>
        </div>
    </div>
</form>

