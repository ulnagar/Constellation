@page
@model Constellation.Presentation.Server.Areas.Admin.Pages.Auth.Roles.IndexModel

@using Constellation.Application.Models.Auth
@using Microsoft.AspNetCore.Authorization

@inject IAuthorizationService AuthorizationService

@{
    var canEdit = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Admin_Authentication_Edit_Value);
}

<h3>Role Management</h3>

<div class="page-menu">
    @if (canEdit.Succeeded)
    {
        <a asp-page="/Auth/Roles/Upsert" , asp-area="Admin" class="btn btn-primary">New</a>
    }
</div>

<hr />

<table class="table table-striped role-data-table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Type</th>
        <th># Users</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var role in Model.Roles)
    {
        <tr>
            <td>@role.Name</td>
            <td>@role.Type</td>
            <td>@role.Members</td>
            <td>
                <a asp-page="/Auth/Roles/Details" asp-area="Admin" asp-route-id="@role.Id" class="btn btn-sm btn-warning btn-show-hover">More Info...</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function (){
            $('.role-data-table').DataTable({
                "order": [
                    [1, 'asc'],
                    [0, 'asc']
                ]
            });
        });
    </script>
}