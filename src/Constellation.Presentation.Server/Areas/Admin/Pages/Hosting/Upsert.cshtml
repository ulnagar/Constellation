@page "{issue:int?}"
@model Constellation.Presentation.Server.Areas.Admin.Pages.Hosting.UpsertModel
@{
}

<h2>@(Model.Issue.HasValue ? "Edit Newsletter" : "New Newsletter")</h2>

<div class="page-menu">
    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />

<form method="post">
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3 row">
            <label asp-for="Issue" class="col-md-2">Issue Number</label>
            <div class="col-md-3">
                <input asp-for="Issue" class="form-control" />
                <span asp-validation-for="Issue" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="Name" class="col-md-2">Name</label>
            <div class="col-md-3">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="EmbedCode" class="col-md-2">Embed Code</label>
            <div class="col-md-3">
                <textarea asp-for="EmbedCode" rows="5" cols="100" class="form-control"></textarea>
                <span asp-validation-for="EmbedCode" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="col-md-offset-2 col-md-3 d-grid">
                <input type="submit" value="Save" class="btn btn-primary btn-lg" />
            </div>
        </div>
    </div>
</form>

@section scripts
{
    <partial name="_ValidationScriptsPartial" />
}