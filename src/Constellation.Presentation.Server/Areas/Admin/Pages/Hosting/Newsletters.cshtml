@page
@using Constellation.Application.Models.Auth
@using Microsoft.AspNetCore.Authorization
@model Constellation.Presentation.Server.Areas.Admin.Pages.Hosting.NewslettersModel

@inject IAuthorizationService AuthorizationService

@{
    var canEdit = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Admin_Hosting_Edit_Value);
}

<h2>Newsletters</h2>

<div class="page-menu">
    @if (canEdit.Succeeded)
    {
        <a asp-page="/Hosting/Upsert" asp-area="Admin" class="btn btn-primary">New</a>
    }
</div>

<hr />

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th></th>
            <th>Issue</th>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Newsletters)
        {
            <tr>
                <td></td>
                <td>@item.Issue</td>
                <td>@item.Name</td>
                <td>
                    @if (canEdit.Succeeded)
                    {
                        <a asp-page="/Hosting/Upsert" asp-area="Admin" asp-route-issue="@item.Issue" class="btn btn-sm btn-warning btn-show-hover">Edit</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({
                "order": [
                    [1, 'asc']
                ]
            });
        })
    </script>
}