@page
@model Constellation.Presentation.Server.Areas.Test.Pages.IndexModel

<h2>Test Page</h2>

<form method="post">

    <div class="mb-3 row">
        <label asp-for="From" class="col-md-2">From</label>
        <div class="col-md-3">
            <input asp-for="From" class="form-control"/>
            <span asp-validation-for="From" class="text-danger"></span>
        </div>
    </div>
    
    <div class="mb-3 row">
        <label asp-for="To" class="col-md-2">To</label>
        <div class="col-md-3">
            <input asp-for="To" class="form-control" />
            <span asp-validation-for="To" class="text-danger"></span>
        </div>
    </div>
    
    <div class="mb-3 row">
        <label asp-for="Message" class="col-md-2">Message</label>
        <div class="col-md-3">
            <textarea asp-for="Message" cols="150" rows="5" class="form-control"></textarea>
            <span asp-validation-for="Message" class="text-danger"></span>
        </div>
    </div>
    
    <div class="mb-3">
        <div class="col-md-offset-2 col-md-3 d-grid">
            <input type="submit" value="Send" class="btn btn-primary btn-block btn-lg" />
        </div>
    </div>
</form>

