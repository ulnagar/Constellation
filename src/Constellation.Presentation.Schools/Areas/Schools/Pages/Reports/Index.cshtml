@page
@using Constellation.Application.Domains.StudentReports.Queries.GetCombinedReportListForSchool
@using Constellation.Core.Extensions
@model Constellation.Presentation.Schools.Areas.Schools.Pages.Reports.IndexModel
@{
}

<h2>School Reports</h2>

<div>
    <div class="mt-3">
        
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>Year</th>
                    <th>Type</th>
                    <th>Report</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                    @{
                        var items = Model.Reports.GroupBy(report => report.DisplayName).ToList();

                        if (items.Count == 0)
                        {
                                <tr class="group"><td colspan="100%">Nothing to see here!</td></tr>
                        }
            
                        foreach (var group in items)
                        {
                            var first = group.First();

                            <tr class="group">
                                <td colspan="6">@first.DisplayName - @first.Grade.AsName()</td>
                            </tr>

                            var byYear = group.OrderBy(entry => entry.Year).GroupBy(entry => entry.Year);

                            @foreach (var year in byYear)
                            {
                                foreach (var entry in year.OfType<SchoolAcademicReportResponse>().OrderBy(report => Convert.ToInt32(report.PublishId)))
                                {
                                    <tr>
                                        <td>@entry.Year</td>
                                        <td>Academic Report</td>
                                        <td>@entry.ReportingPeriod</td>
                                        <td>
                                            <a asp-page-handler="Download" asp-route-reportId="@entry.Id" class="btn btn-info btn-show-hover">Download</a>
                                        </td>
                                    </tr>
                                }

                                foreach (var entry in year.OfType<SchoolExternalReportResponse>().OrderBy(report => report.IssuedDate))
                                {
                                    <tr>
                                        <td>@entry.Year</td>
                                        <td>External Report</td>
                                        <td>@entry.Type - @entry.IssuedDate.ToString("MMM yyyy")</td>
                                        <td>
                                            <a asp-page-handler="DownloadExternal" asp-route-reportId="@entry.Id" class="btn btn-info btn-show-hover">Download</a>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>