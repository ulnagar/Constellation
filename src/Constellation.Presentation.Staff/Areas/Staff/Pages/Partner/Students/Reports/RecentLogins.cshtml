@page
@using Constellation.Core.Extensions
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Students.Reports.RecentLoginsModel
@{
}

<h2>Student Login History</h2>

<div class="page-menu">
    <a asp-page-handler="Export" class="btn btn-secondary">Export</a>
</div>

<hr />

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Student</th>
        <th>Grade</th>
        <th>School</th>
        <th>Login Time</th>
        <th></th>
    </tr>
    </thead>

    <tbody>
    @foreach (var entry in Model.Logins)
    {
        <tr>
            <td data-order="@entry.Student.SortOrder" data-search="@entry.Student.DisplayName @entry.Student.FirstName">@entry.Student.DisplayName</td>
            <td>@entry.Grade.AsName()</td>
            <td>@entry.SchoolName</td>
            <td data-order="@entry.LastLoginTime?.ToString("s")">@entry.LastLoginTime?.ToLocalTime()</td>
            <td></td>
        </tr>
    }
    </tbody>
</table>

@section Scripts
{
    <script>
        $(document).ready(function() {
            $('table').DataTable({
                "order": [
                    [1, 'asc'],
                    [0, 'asc']
                ]
            });
        })
    </script>
}