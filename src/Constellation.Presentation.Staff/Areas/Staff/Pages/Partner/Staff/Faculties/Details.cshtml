@page "{facultyId}"
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Staff.Faculties.DetailsModel

@inject IAuthorizationService AuthorizationService

@{
    var canEditTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Partners_Faculties_Edit_Value);
}

<h2>Faculty Details</h2>

<div class="page-menu">
    @if (canEditTest.Succeeded)
    {
        <a class="btn btn-secondary" asp-page="/Partner/Staff/Faculties/Upsert" asp-area="Staff" asp-route-Id="@Model.FacultyId">Edit</a>
    }

    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />

<div>
    <dl class="row">
        <dt class="col-md-2">
            <label asp-for="Faculty.FacultyId">Id</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.Faculty.FacultyId</span>
        </dd>

        <dt class="col-md-2">
            <label asp-for="Faculty.Name"></label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.Faculty.Name</span>
        </dd>

        <dt class="col-md-2">
            <label asp-for="Faculty.Colour"></label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.Faculty.Colour</span>
        </dd>
    </dl>
</div>

<hr />

<h3>Current Members</h3>

<div class="mb-3">
    @if (canEditTest.Succeeded)
    {
        <a asp-page="/Partner/Staff/Faculties/AddMember" asp-area="Staff" asp-route-facultyId="@Model.Faculty.FacultyId.Value" class="btn btn-info">Add Member</a>
    }
</div>

<div>
    <div id="expiring" class="tab-pane active" role="tabpanel">
        <table class="table table-striped table-hover data-table">
            <thead>
            <tr>
                <th>Name</th>
                <th>Member Type</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Faculty.Members)
            {
                <tr>
                    <td data-order="@item.StaffName.SortOrder" data-search="@item.StaffName.DisplayName @item.StaffName.FirstName">@item.StaffName.DisplayName</td>
                    <td>@item.Role</td>
                    <td>
                        @if (canEditTest.Succeeded)
                        {
                            <button class="btn btn-sm btn-danger btn-show-hover remove-button" data-staff-id="@item.StaffId">Remove</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section scripts
{
    <script>
        $(document).ready(function (){
            $('.data-table').DataTable({
                "order": [
                    [1, 'asc']
                ]
            });
        });

        $('.remove-button').click(function(event) {
            var staffId = $(this).data("staffId");
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "?handler=AjaxRemoveMember",
                type: "POST",
                data: {
                    staffId: staffId,
                    __RequestVerificationToken: xsrfHeader
                }
            }).done(function(data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        });
    </script>
}