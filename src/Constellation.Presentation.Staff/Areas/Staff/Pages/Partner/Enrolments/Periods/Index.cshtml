@page
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Periods.IndexModel

@using Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Periods
@inject IAuthorizationService AuthorizationService

@{
    var canEditTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Partners_Enrolments_Applications_Edit_Value);
}

<h2>Enrolment Periods</h2>

<div class="page-menu">
    @{
        var allStyle = "btn-outline-secondary";
        var currentStyle = allStyle;
        var archiveStatus = allStyle;

        switch (Model.Filter)
        {
            case IndexModel.EnrolmentPeriodFilter.All:
                allStyle = "btn-primary";
                break;
            case IndexModel.EnrolmentPeriodFilter.Current:
                currentStyle = "btn-primary";
                break;
            case IndexModel.EnrolmentPeriodFilter.Archived:
                archiveStatus = "btn-primary";
                break;
        }
    }

    <div class="btn-group">
        <a asp-route-filter="@IndexModel.EnrolmentPeriodFilter.All" class="btn @allStyle">All</a>
        <a asp-route-filter="@IndexModel.EnrolmentPeriodFilter.Current" class="btn @currentStyle">Current</a>
        <a asp-route-filter="@IndexModel.EnrolmentPeriodFilter.Archived" class="btn @archiveStatus">Archived</a>
    </div>

    @if (canEditTest.Succeeded)
    {
        <a asp-page="/Partner/Enrolments/Periods/Upsert" asp-area="Staff" class="btn btn-success">Create</a>
    }
</div>

<hr />

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Name</th>
        <th>Program</th>
        <th>Open</th>
        <th>Close</th>
        <th>Status</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var period in Model.Periods)
    {
        <tr>
            <td>
                @period.Label
            </td>
            <td>
                @period.Program
            </td>
            <td data-order="@period.OpenAt">
                @period.OpenAt.ToString("d MMM yyyy, h:mm tt")
            </td>
            <td data-order="@period.ClosedAt">
                @period.ClosedAt.ToString("d MMM yyyy, h:mm tt")
            </td>
            <td>@period.Status</td>
            <td>
                @if (canEditTest.Succeeded)
                {
                    <a asp-page="/Partner/Enrolments/Periods/Details" asp-route-Id="@period.Id" class="btn btn-sm btn-info btn-show-hover showLoader">More Info...</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({
                "order": [
                    [2, 'desc']
                ],
                "columnDefs": [
                    { "target": 5, "searchable": false, "sortable": false }
                ]
            });
        })
    </script>
}