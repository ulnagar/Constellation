@page "{id?}"
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Periods.UpsertModel

@using Constellation.Core.Models.EnrolmentContext.Application.Enums
@using Constellation.Core.Models.EnrolmentContext.EnrolmentPeriod.Identifiers

@{
    bool newItem = Model.Id == EnrolmentPeriodId.Empty;
}

<h2>@(newItem ? "New Enrolment Period" : "Editing Enrolment Period")</h2>

<div class="page-menu">
    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />

<form method="post">
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <input type="hidden" asp-for="Id" />

        <div class="mb-3 row">
            <label asp-for="Label" class="col-md-2">Label</label>
            <div class="col-md-3">
                <input asp-for="Label" class="form-control" />
                <span asp-validation-for="Label" class="text-danger"></span>
            </div>
        </div>
        
        <div class="mb-3 row">
            <label asp-for="Year" class="col-md-2">Year</label>
            <div class="col-md-3">
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="OpenAt" class="col-md-2">Available From</label>
            <div class="col-md-3">
                <input asp-for="OpenAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="OpenAt" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="ClosedAt" class="col-md-2">Available Until</label>
            <div class="col-md-3">
                <input asp-for="ClosedAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="ClosedAt" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="Program" class="col-md-2">Program</label>
            <div class="col-md-5">
                <select id="Program" name="Program" asp-items="@Model.ProgramList" class="form-control select2">
                    <option value=""> -- Select -- </option>
                </select>
                <span asp-validation-for="Program" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="SelectedCourses" class="col-md-2">Available Courses</label>
            <div class="col-md-5">
                <select asp-for="SelectedCourses" multiple="multiple" class="form-control select2">
                    <option value=""> -- Select -- </option>
                    @foreach (var entry in EnrolmentCourse.GetOptions)
                    {
                        if (Model.SelectedCourses.Contains(entry))
                        {
                            <option value="@entry.Value" selected="selected">@entry.Name</option>
                        }
                        else
                        {
                            <option value="@entry.Value">@entry.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="SelectedCourses" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <div class="col-md-offset-2 col-md-3 d-grid">
                @if (Model.Id == EnrolmentPeriodId.Empty)
                {
                    <input asp-page-handler="Create" type="submit" value="Save" class="btn btn-primary btn-lg" />
                }
                else
                {
                    <input asp-page-handler="Update" type="submit" value="Save" class="btn btn-primary btn-lg" />
                }
            </div>
        </div>
    </div>
</form>

@section Scripts
{
    <script>
        (function() {
            $('.select2').select2({
                theme: 'bootstrap-5'
            });
        }());
    </script>
}
