@page
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Offers.IndexModel

@using Constellation.Core.Extensions
@using Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Offers

@inject IAuthorizationService AuthorizationService
@{
    var canEditTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Partners_Enrolments_Offers_Edit_Value);
}

<h2>Offers</h2>

<div class="page-menu">
    @{
        var allStyle = "btn-outline-secondary";
        var processingStyle = allStyle;
        var pendingStyle = allStyle;
        var acceptedStyle = allStyle;
        var declinedStyle = allStyle;

        switch (Model.Status)
        {
            case IndexModel.StatusFilter.All:
                allStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Processing:
                processingStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Pending:
                pendingStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Accepted:
                acceptedStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Declined:
                declinedStyle = "btn-primary";
                break;
        }
    }

    <div class="btn-group">
        <a asp-route-status="@IndexModel.StatusFilter.All" asp-route-periodId="@Model.PeriodId" class="btn @allStyle">All</a>
        <a asp-route-status="@IndexModel.StatusFilter.Processing" asp-route-periodId="@Model.PeriodId" class="btn @processingStyle">Processing</a>
        <a asp-route-status="@IndexModel.StatusFilter.Pending" asp-route-periodId="@Model.PeriodId" class="btn @pendingStyle">Pending</a>
        <a asp-route-status="@IndexModel.StatusFilter.Accepted" asp-route-periodId="@Model.PeriodId" class="btn @acceptedStyle">Accepted</a>
        <a asp-route-status="@IndexModel.StatusFilter.Declined" asp-route-periodId="@Model.PeriodId" class="btn @declinedStyle">Declined</a>
    </div>
    
    @if (canEditTest.Succeeded)
    {
        <button class="btn btn-secondary" id="export-button">Export</button>

        <div class="btn-group" role="group">
            <button class="btn btn-warning" id="bulk-send-offer-button">Send Offers</button>
        </div>
    }
</div>

<hr />

<div class="mb-3 row">
    <label class="col-md-2">Current Enrolment Period</label>
    <label class="col-md-5">@Model.Period.Label</label>
    <div class="col-md-2">
        <vc:period-switcher />
    </div>
</div>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Ref</th>
        <th>Name</th>
        <th>Gender</th>
        <th>School</th>
        <th>Grade</th>
        <th>Status</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var offer in Model.Offers)
    {
        <tr>
            <td data-id="@offer.Id">@offer.ApplicationReference</td>
            <td data-order="@offer.StudentName.SortOrder" data-search="@offer.StudentName.DisplayName @offer.StudentName.FirstName">@offer.StudentName.DisplayName</td>
            <td>@offer.StudentGender</td>
            <td data-search="@offer.DestinationSchoolCode @offer.DestinationSchool">@offer.DestinationSchool</td>
            <td data-search="@offer.Grade.AsNumber()">@offer.Grade.AsName()</td>
            <td>@offer.Status</td>
            <td>
                @if (canEditTest.Succeeded)
                {
                    <a asp-page="/Partner/Enrolments/Offers/Details" asp-route-Id="@offer.Id" asp-route-PeriodId="@Model.PeriodId" class="btn btn-sm btn-info btn-show-hover showLoader">More Info...</a>
                    <a asp-page="/Partner/Enrolments/Offers/Respond" asp-route-Id="@offer.Id" asp-route-PeriodId="@Model.PeriodId" class="btn btn-sm btn-info btn-show-hover showLoader">Respond</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<form method="post" asp-page-handler="BulkSendOffer" asp-route-PeriodId="@Model.PeriodId">
    <div class="modal fade" tabindex="-1" id="bulk-send-offer-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Send Offer</h5>
                    <input asp-for="@Model.PeriodId" type="hidden" />
                    <input asp-for="@Model.Status" type="hidden" />
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="form-group col-12">
                            <span class="control-label">This will attempt to send <span class="send-offer-affected-rows fw-bold"></span> new offer emails to parents.</span>
                        </div>
                        <div class="hidden send-offer-row-ids"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success show-loader">Send</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section scripts
{
    <script>
        $(document).ready(function (){
            const table = $('table').DataTable({ 
                "order": [
                    [1, 'asc']
                ],
                "columnDefs": [
                    { "target": 6, "searchable": false, "sortable": false }
                ]
            });

            function getIdsFromTable() {
                const Ids = [];

                // rows({ search: 'applied' }) respects the current DataTable filter/search state
                table.rows({ search: 'applied' }).every(function() {
                    const row = this.node();
                    Ids.push($('td:eq(0)', row).data('id'));
                });

                return Ids;
            }

            function getCountOfVisibleProcessingTableRows() {
                return table.rows(
                    function(idx, data, node) {
                        return data[5] === 'Processing';
                    },
                    { search: 'applied' })
                    .count();
            }
            
            function getProcessingIdsFromTable() {
                const Ids = [];

                table.rows(
                    function (idx, data, node) {
                        return data[5] === 'Processing';
                    },
                    { search: 'applied'})
                    .every(function() {
                        const row = this.node();
                        Ids.push($('td:eq(0)', row).data('id'));
                    });

                return Ids;
            }

            $('#bulk-send-offer-button').on('click', function () {
                const rowCount = getCountOfVisibleProcessingTableRows();
                $('.send-offer-affected-rows').text(rowCount);
                $('.send-offer-row-ids').empty();

                const offerIds = getProcessingIdsFromTable();
                offerIds.forEach((id) => {
                    $('.send-offer-row-ids').append(
                        $('<input>', {
                            type: 'hidden',
                            name: 'offerIds',
                            value: id
                        })
                    );
                });

                const modalEl = document.getElementById('bulk-send-offer-modal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            });

            $('#export-button').on('click', async function() {
                const offerIds = getIdsFromTable();

                if (offerIds.length === 0) {
                    alert('No recipients found.');
                    return;
                }

                const formData = new URLSearchParams();
                offerIds.forEach((id, index) => {
                    formData.append(`offerIds[${index}]`, id);
                });

                const response = await fetch('?handler=Export', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: formData.toString()
                });

                if (!response.ok) {
                    alert('Export failed.');
                    return;
                }

                // Try to pull the filename the server suggested
                const disposition = response.headers.get('Content-Disposition');
                let filename = 'export.xlsx'; // fallback
                if (disposition) {
                    const match = disposition.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i);
                    if (match && match[1]) {
                        filename = decodeURIComponent(match[1]);
                    }
                }

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);

                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                a.remove();

                window.URL.revokeObjectURL(url);
            });
        });
    </script>
}