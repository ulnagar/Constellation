@page "{key}"
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Applications.ImportModel
@{
}

<h2>Import Applications</h2>

@if (Model.ImportFinished)
{
    if (Model.ImportResult is null)
    {
        // Just show import error message
    }
    else if (!Model.ImportResult.HasFailures)
    {
        <p>Import Successful! @Model.ImportResult.SucceededCount Applications created or updated.</p>
    }
    else
    {
        <p>Errors found during import. @Model.ImportResult.SucceededCount Applications created or updated successfully.</p>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Row</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.ImportResult.Failures)
                {
                    <tr>
                        <td>@row.RowNumber</td>
                        <td>@row.Error</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    var grouped = Model.FieldDefinitions
        .GroupBy(f => f.GroupLabel) // null key = ungrouped, standalone fields
        .ToList();

    <form asp-page-handler="Map" method="post">

        <div class="mb-3 row">
            <label for="PeriodId" class="col-md-2">Enrolment Period</label>
            <div class="col-md-3">
                <select name="PeriodId" id="PeriodId" class="form-control">
                    <option value=""> -- Select -- </option>
                    @foreach (var period in Model.Periods)
                    {
                        <option value="@period.Id"
                                selected="@(period.Id == Model.PeriodId ? "selected" : null)">
                            @period.Label
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </div>
        
        <input type="hidden" name="Mapping.Token" value="@Model.Key" />
    
        @foreach (var group in grouped)
        {
            if (group.Key is not null)
            {
                <fieldset class="mb-3">
                    <legend class="form-label fs-5 mb-3">@group.Key</legend>
                    @foreach (var field in group)
                    {
                        <div class="row mb-3 mapping-row @(field.Required ? "mapping-row--required" : "")">
                            <label for="mapping-@field.Key" class="col-md-3">
                                @field.Label
                                @if (field.Required)
                                {
                                    <span class="required-marker" aria-hidden="true">*</span>
                                    <span class="visually-hidden">(required)</span>
                                }
                            </label>

                            <div class="col-md-5">
                                <select id="mapping-@field.Key" name="Mapping.Mappings[@field.Key]" class="form-control custom-select2">
                                    <option value="">-- not present --</option>
                                    @foreach (var header in Model.AvailableHeaders)
                                    {
                                        <option value="@header" selected="@(Model.Mapping.Mappings.GetValueOrDefault(field.Key) == header)">
                                            @header
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </fieldset>
            }
            else
            {
                @foreach (var field in group)
                {
                    <div class="row mb-3 mapping-row @(field.Required ? "mapping-row--required" : "")">
                        <label for="mapping-@field.Key" class="col-md-3">
                            @field.Label
                            @if (field.Required)
                            {
                                <span class="required-marker" aria-hidden="true">*</span>
                                <span class="visually-hidden">(required)</span>
                            }
                        </label>

                        <div class="col-md-5">
                            <select id="mapping-@field.Key" name="Mapping.Mappings[@field.Key]" class="form-control custom-select2">
                                <option value="">-- not present --</option>
                                @foreach (var header in Model.AvailableHeaders)
                                {
                                    <option value="@header" selected="@(Model.Mapping.Mappings.GetValueOrDefault(field.Key) == header)">
                                        @header
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                }
            }
        }

        <div class="mb-3">
            <div class="col-md-offset-2 col-md-3 d-grid">
                <input type="submit" value="Save" class="btn btn-primary btn-lg" />
            </div>
        </div>

    </form>
}

@section scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({ 
                "order": [
                    [0, 'asc']
                ]
            });
        })
    </script>
}