@page
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Applications.IndexModel

@using Constellation.Core.Extensions
@using Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Applications;

@inject IAuthorizationService AuthorizationService
@{
    var canEditTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Partners_Enrolments_Applications_Edit_Value);
}

<h2>Enrolment Applications</h2>

<div class="page-menu">
    @{
        var allStyle = "btn-outline-secondary";
        var pendingStyle = allStyle;
        var approvedStyle = allStyle;
        var rejectedStyle = allStyle;

        switch (Model.Status)
        {
            case IndexModel.StatusFilter.All:
                allStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Pending:
                pendingStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Approved:
                approvedStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Rejected:
                rejectedStyle = "btn-primary";
                break;
        }
    }

    <div class="btn-group">
        <a asp-route-status="@IndexModel.StatusFilter.All" asp-route-periodId="@Model.PeriodId" class="btn @allStyle">All</a>
        <a asp-route-status="@IndexModel.StatusFilter.Pending" asp-route-periodId="@Model.PeriodId" class="btn @pendingStyle">Pending</a>
        <a asp-route-status="@IndexModel.StatusFilter.Approved" asp-route-periodId="@Model.PeriodId" class="btn @approvedStyle">Approved</a>
        <a asp-route-status="@IndexModel.StatusFilter.Rejected" asp-route-periodId="@Model.PeriodId" class="btn @rejectedStyle">Rejected</a>
    </div>

    @if (canEditTest.Succeeded)
    {
        <a asp-page="/Partner/Enrolments/Applications/Upsert" asp-area="Staff" class="btn btn-success">Create</a>
        <button data-bs-toggle="modal" data-bs-target="#import-modal" class="btn btn-success">Import</button>
        <a class="btn btn-success">Export</a>
    }
</div>

<hr />

<form method="get">
    <div class="mb-3 row">
        <label for="PeriodId" class="col-md-2">Enrolment Period</label>
        <div class="col-md-3">
            <input type="hidden" name="Status" value="@Model.Status" />
            <select name="PeriodId" id="PeriodId" class="form-control">
                <option value=""> -- Select -- </option>
                @foreach (var period in Model.Periods)
                {
                    <option value="@period.Id"
                            selected="@(period.Id == Model.PeriodId ? "selected" : null)">
                        @period.Label
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Ref</th>
        <th>Name</th>
        <th>Gender</th>
        <th>School</th>
        <th>Grade</th>
        <th>Status</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var application in Model.Applications)
    {
        <tr>
            <td>@application.ApplicationReference</td>
            <td data-order="@application.StudentName.SortOrder" data-search="@application.StudentName.DisplayName @application.StudentName.FirstName">@application.StudentName.DisplayName</td>
            <td>@application.StudentGender</td>
            <td data-search="@application.DestinationSchoolCode @application.DestinationSchool">@application.DestinationSchool</td>
            <td data-search="@application.Grade.AsNumber()">@application.Grade.AsName()</td>
            <td>@application.Status</td>
            <td>
                @if (canEditTest.Succeeded)
                {
                    <a asp-page="/Partner/Enrolments/Applications/Details" asp-route-Id="@application.Id" class="btn btn-sm btn-info btn-show-hover showLoader">More Info...</a>
                    <a asp-page="/Partner/Enrolments/Applications/Upsert" asp-route-Id="@application.Id" class="btn btn-sm btn-info btn-show-hover showLoader">Edit</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<vc:upload-file-for-import-staging />

@section scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({ 
                "order": [
                    [1, 'asc']
                ],
                "columnDefs": [
                    { "target": 6, "searchable": false, "sortable": false }
                ]
            });
        })
    </script>
}