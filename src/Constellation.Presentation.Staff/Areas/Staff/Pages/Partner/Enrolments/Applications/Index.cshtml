@page
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Applications.IndexModel

@using Constellation.Core.Extensions
@using Constellation.Core.Models.EnrolmentContext.Application.Enums
@using Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Applications;

@inject IAuthorizationService AuthorizationService
@{
    var canEditTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Partners_Enrolments_Applications_Edit_Value);
}

<h2>Enrolment Applications</h2>

<div class="page-menu">
    @{
        var allStyle = "btn-outline-secondary";
        var pendingStyle = allStyle;
        var approvedStyle = allStyle;
        var rejectedStyle = allStyle;

        switch (Model.Status)
        {
            case IndexModel.StatusFilter.All:
                allStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Pending:
                pendingStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Approved:
                approvedStyle = "btn-primary";
                break;
            case IndexModel.StatusFilter.Rejected:
                rejectedStyle = "btn-primary";
                break;
        }
    }

    <div class="btn-group">
        <a asp-route-status="@IndexModel.StatusFilter.All" asp-route-periodId="@Model.PeriodId" class="btn @allStyle">All</a>
        <a asp-route-status="@IndexModel.StatusFilter.Pending" asp-route-periodId="@Model.PeriodId" class="btn @pendingStyle">Pending</a>
        <a asp-route-status="@IndexModel.StatusFilter.Approved" asp-route-periodId="@Model.PeriodId" class="btn @approvedStyle">Approved</a>
        <a asp-route-status="@IndexModel.StatusFilter.Rejected" asp-route-periodId="@Model.PeriodId" class="btn @rejectedStyle">Rejected</a>
    </div>

    @if (canEditTest.Succeeded)
    {
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown">Create <span class="caret"></span></button>
            <div class="dropdown-menu">
                <a asp-page="/Partner/Enrolments/Applications/Upsert" asp-area="Staff" asp-route-PeriodId="@Model.PeriodId" class="dropdown-item">Manually</a>
                <button data-bs-toggle="modal" data-bs-target="#import-modal" class="dropdown-item">Import</button>
            </div>
        </div>

        <button class="btn btn-secondary" id="export-button">Export</button>

        <div class="btn-group" role="group">
            <button type="button" class="btn btn-warning dropdown-toggle" data-bs-toggle="dropdown">Bulk Actions <span class="caret"></span></button>
            <div class="dropdown-menu">
                <button class="dropdown-item" id="bulk-update-status-button">Update Status</button>
                <button class="dropdown-item" id="bulk-create-offer-button">Create Offers</button>
            </div>
        </div>
    }
</div>

<hr />

<vc:period-switcher />

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Ref</th>
        <th>Name</th>
        <th>Gender</th>
        <th>School</th>
        <th>Grade</th>
        <th>Status</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var application in Model.Applications)
    {
        <tr>
            <td data-id="@application.Id">@application.ApplicationReference</td>
            <td data-order="@application.StudentName.SortOrder" data-search="@application.StudentName.DisplayName @application.StudentName.FirstName">@application.StudentName.DisplayName</td>
            <td>@application.StudentGender</td>
            <td data-search="@application.DestinationSchoolCode @application.DestinationSchool">@application.DestinationSchool</td>
            <td data-search="@application.Grade.AsNumber()">@application.Grade.AsName()</td>
            <td>@application.Status</td>
            <td>
                @if (canEditTest.Succeeded)
                {
                    <a asp-page="/Partner/Enrolments/Applications/Details" asp-route-Id="@application.Id" asp-route-PeriodId="@Model.PeriodId" class="btn btn-sm btn-info btn-show-hover showLoader">More Info...</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

<vc:upload-file-for-import-staging />

<form method="post" asp-page-handler="BulkUpdateStatus">
    <div class="modal fade" tabindex="-1" id="bulk-update-status-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Status</h5>
                    <input asp-for="@Model.PeriodId" type="hidden" />
                    <input asp-for="@Model.Status" type="hidden" />
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="form-group col-12">
                            <span class="control-label">Updating the status here will change <span class="update-status-affected-rows fw-bold"></span> rows.</span>
                        </div>
                        <div class="hidden update-status-row-ids"></div>
                    </div>
                    
                    <div class="row mb-3">
                        <label class="col-md-3">New Status</label>
                        <div class="col-md-9">
                            @{
                                var statusItems = Html.GetEnumSelectList<ApplicationStatus>()
                                    .Where(item => item.Text != nameof(ApplicationStatus.Offered));
                            }

                            <select name="newstatus" asp-items="statusItems" class="combo">
                                <option> -- Select Status -- </option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success show-loader">Update</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</form>

<form method="post" asp-page-handler="BulkCreateOffer">
    <div class="modal fade" tabindex="-1" id="bulk-create-offer-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Offer</h5>
                    <input asp-for="@Model.PeriodId" type="hidden" />
                    <input asp-for="@Model.Status" type="hidden" />
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="form-group col-12">
                            <span class="control-label">This will attempt to create <span class="create-offer-affected-rows fw-bold"></span> new offers.</span>
                        </div>
                        <div class="hidden create-offer-row-ids"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success show-loader">Create</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section scripts
{
    <script>
        $(document).ready(function (){
            const table = $('table').DataTable({ 
                "order": [
                    [1, 'asc']
                ],
                "columnDefs": [
                    { "target": 6, "searchable": false, "sortable": false }
                ]
            });

            function getCountOfVisibleTableRows() {
                return table.rows({ search: 'applied' }).count();
            }

            function getCountOfVisibleApprovedTableRows() {
                return table.rows(
                    function(idx, data, node) {
                        return data[5] === 'Approved';
                    },
                    { search: 'applied' })
                    .count();
            }

            $('#bulk-update-status-button').on('click', function() {
                // Update the span text
                const rowCount = getCountOfVisibleTableRows();
                $('.update-status-affected-rows').text(rowCount);

                $('.update-status-row-ids').empty();

                const applicationIds = getIdsFromTable();
                applicationIds.forEach((id) => {
                    $('.update-status-row-ids').append(
                        $('<input>', {
                            type: 'hidden',
                            name: 'applicationIds',
                            value: id
                        })
                    );
                });

                const modalEl = document.getElementById('bulk-update-status-modal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            });

            $('#bulk-create-offer-button').on('click', function() {
                // Update the span text
                const rowCount = getCountOfVisibleApprovedTableRows();
                $('.create-offer-affected-rows').text(rowCount);
                
                $('#bulk-create-offer-modal .btn-success').removeClass('d-none');
                $('.create-offer-row-ids').empty();

                const applicationIds = getApprovedIdsFromTable();
                applicationIds.forEach((id) => {
                    $('.create-offer-row-ids').append(
                        $('<input>', {
                            type: 'hidden',
                            name: 'applicationIds',
                            value: id
                        })
                    );
                });

                if (rowCount === 0) {
                    $('#bulk-create-offer-modal .btn-success').addClass('d-none');
                }

                const modalEl = document.getElementById('bulk-create-offer-modal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            });

            function getIdsFromTable() {
                const Ids = [];

                // rows({ search: 'applied' }) respects the current DataTable filter/search state
                table.rows({ search: 'applied' }).every(function() {
                    const row = this.node();
                    Ids.push($('td:eq(0)', row).data('id'));
                });

                return Ids;
            }

            function getApprovedIdsFromTable() {
                const Ids = [];

                // rows({ search: 'applied' }) respects the current DataTable filter/search state
                table.rows(
                    function (idx, data, node) {
                        return data[5] === 'Approved';
                    },
                    { search: 'applied'})
                    .every(function() {
                        const row = this.node();
                        Ids.push($('td:eq(0)', row).data('id'));
                    });

                return Ids;
            }

            $('#export-button').on('click', async function() {
                const applicationIds = getIdsFromTable();

                if (applicationIds.length === 0) {
                    alert('No recipients found.');
                    return;
                }

                const formData = new URLSearchParams();
                applicationIds.forEach((id, index) => {
                    formData.append(`applicationIds[${index}]`, id);
                });

                const response = await fetch('?handler=Export', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: formData.toString()
                });

                if (!response.ok) {
                    alert('Export failed.');
                    return;
                }

                // Try to pull the filename the server suggested
                const disposition = response.headers.get('Content-Disposition');
                let filename = 'export.xlsx'; // fallback
                if (disposition) {
                    const match = disposition.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i);
                    if (match && match[1]) {
                        filename = decodeURIComponent(match[1]);
                    }
                }

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);

                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                a.remove();

                window.URL.revokeObjectURL(url);
            });

        });
    </script>
}