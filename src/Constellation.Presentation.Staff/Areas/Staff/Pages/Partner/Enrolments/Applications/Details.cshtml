@page "{id}"
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Partner.Enrolments.Applications.DetailsModel

@using Constellation.Core.Extensions
@using Constellation.Core.Models.EnrolmentContext.Application.Enums

@inject IAuthorizationService AuthorizationService

@{
    var canEditTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Partners_Enrolments_Applications_Edit_Value);
}

<h2>Enrolment Application Details</h2>

<div class="page-menu">
    @if (canEditTest.Succeeded)
    {
        if (Model.Application.Status == ApplicationStatus.Pending)
        {
            <a asp-page="/Partner/Enrolments/Applications/Upsert" asp-area="Staff" asp-route-id="@Model.Id" class="btn btn-success">Edit</a>
        }

        if (Model.Application.Status != ApplicationStatus.Offered)
        {
            <button data-bs-toggle="modal" data-bs-target="#update-status-modal" class="btn btn-warning">Update Status</button>
        }

        if (Model.Application.Status == ApplicationStatus.Approved)
        {
            <button data-bs-toggle="modal" data-bs-target="#create-offer-modal" class="btn btn-warning">Create Offer</button>
        }
    }

    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />
        
<h4>Student Details</h4>

<dl class="row">
    <dt class="col-md-2">
        <label asp-for="Application.StudentReferenceNumber">SRN</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.StudentReferenceNumber</span>
    </dd>
    
    <dt class="col-md-2">
        <label asp-for="Application.StudentName">Name</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.StudentName</span>
    </dd>
    
    <dt class="col-md-2">
        <label asp-for="Application.StudentGender">Gender</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.StudentGender</span>
    </dd>
    
    <dt class="col-md-2">
        <label asp-for="Application.DateOfBirth">Date Of Birth</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.DateOfBirth?.ToString("d")</span>
    </dd>
    
    <dt class="col-md-2">
        <label asp-for="Application.StudentEmailAddress">Email Address</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.StudentEmailAddress</span>
    </dd>
</dl>

<h4>Parent Details</h4>

<dl class="row">
    <dt class="col-md-2">
        <label asp-for="Application.ParentName">Name</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.ParentName</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.ParentEmailAddress">Email Address</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.ParentEmailAddress</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.ParentPhoneNumber">Phone Number</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.ParentPhoneNumber</span>
    </dd>
</dl>

<h4>Mailing Address</h4>

<dl class="row">
    <dt class="col-md-2">
        <label asp-for="Application.MailingAddress.Street">Street Address</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.MailingAddress?.Street</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.MailingAddress.Town">Town</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.MailingAddress?.Town</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.MailingAddress.State">State</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.MailingAddress?.State</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.MailingAddress.Postcode">Post Code</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.MailingAddress?.Postcode</span>
    </dd>
</dl>

<h4>Application Details</h4>

<dl class="row">
    <dt class="col-md-2">
        <label asp-for="Application.PeriodName">Enrolment Period</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.PeriodName</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.ApplicationReference">Reference</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.ApplicationReference</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.CurrentSchool">Current School</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.CurrentSchoolCode - @Model.Application.CurrentSchool</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.DestinationSchool">Destination School</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.DestinationSchoolCode - @Model.Application.DestinationSchool</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.Program">Program</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.Program</span>
    </dd>

    <dt class="col-md-2">
        <label asp-for="Application.Grade">Grade</label>
    </dt>
    <dd class="col-md-10">
        <span>@Model.Application.Grade.AsName()</span>
    </dd>
</dl>

@if (Model.Application.SelectedCourses.Any())
{

    <h4>Subjects</h4>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        @foreach (var entry in Model.Application.SelectedCourses)
        {
            <tr>
                <td>@entry.Course.Value</td>
                <td>@entry.Course.Name</td>
                <td>@entry.Status</td>
                <td>
                    @if (entry.Status != CourseSelectionStatus.Withdrawn)
                    {
                        <form method="post">
                            <input type="hidden" name="course" value="@entry.Course.Value" />
                            <button type="submit" asp-page-handler="RejectApplication" class="btn btn-danger">Reject</button>
                            <button type="submit" asp-page-handler="ApproveApplication" class="btn btn-success">Approve</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </table>
}

<form method="post" asp-page-handler="UpdateStatus">
    <div class="modal fade" tabindex="-1" id="update-status-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Update Status</h5>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <label class="col-md-3">New Status</label>
                        <div class="col-md-9">
                            <select name="status" asp-items="@Html.GetEnumSelectList<ApplicationStatus>()" class="combo">
                                <option> -- Select Status -- </option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success show-loader">Update</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</form>

<form method="post" asp-page-handler="CreateOffer">
    <div class="modal fade" tabindex="-1" id="create-offer-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Offer</h5>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="form-group col-12">
                            <span class="control-label">Are you sure you want to generate an Offer from this Application?</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success show-loader">Create</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section scripts
{
    <script>
        $(document).ready(function (){
            const table = $('table').DataTable({ 
                "order": [
                    [1, 'asc']
                ],
                "columnDefs": [
                    { "target": 3, "searchable": false, "sortable": false }
                ]
            });
        });
    </script>
}