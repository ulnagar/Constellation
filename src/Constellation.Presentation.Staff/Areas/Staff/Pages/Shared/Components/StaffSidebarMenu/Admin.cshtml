@using Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.Components.StaffSidebarMenu
@model string

<nav id="sidebarMenu" class="d-md-block bg-light sidebar collapse">
    <div class="sidebar-sticky pt-3">
        <h4 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-1 text-muted" role="button">
            <span class="w-100">Admin</span>
        </h4>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(Model == ActivePage.Admin_Emergency_Console ? "active" : "")" asp-page="/Emergency/Index" asp-area="Admin">
                    Emergency Console
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model == ActivePage.Admin_Emergency_Templates ? "active" : "")" asp-page="/Emergency/Templates/Index" asp-area="Admin">
                    Templates
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model == ActivePage.Admin_Emergency_Sent ? "active" : "")" asp-page="/Emergency/Sent" asp-area="Admin">
                    Send Log
                </a>
            </li>
        </ul>
    </div>
</nav>