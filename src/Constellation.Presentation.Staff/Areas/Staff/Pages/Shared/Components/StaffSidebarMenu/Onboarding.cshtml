@using Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.Components.StaffSidebarMenu
@model string

<nav id="sidebarMenu" class="d-md-block bg-light sidebar collapse">
    <div class="sidebar-sticky pt-3">
        <h4 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-1 text-muted" role="button">
            <span class="w-100">Applications</span>
        </h4>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(Model == ActivePage.Onboarding_Application_List ? "active" : "")" asp-page="/Onboarding/Applications/Index" asp-area="Staff">
                    List
                </a>
            </li>
        </ul>
        
        <h4 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-1 text-muted" role="button">
            <span class="w-100">Enrolments</span>
        </h4>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(Model == ActivePage.Onboarding_Enrolment_List ? "active" : "")" asp-page="/Onboarding/Enrolments/Index" asp-area="Staff">
                    List
                </a>
            </li>
        </ul>
    </div>
</nav>
