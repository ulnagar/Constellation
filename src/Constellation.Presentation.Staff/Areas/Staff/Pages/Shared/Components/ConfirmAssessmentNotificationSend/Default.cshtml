@model Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.Components.ConfirmAssessmentNotificationSend.ConfirmAssessmentNotificationSendSelection

<form method="post" asp-page-handler="SendNotifications">
    <div class="modal fade" tabindex="-1" id="confirm-notifications-modal">
        <div class="modal-dialog">
            <div id="modal-content" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Send Notifications</h5>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group col">
                            <span class="control-label">Are you sure you want to send notification emails to all selected recipients below?</span>
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IncludeStudents" id="includeStudents">
                            <label class="form-check-label" for="includeStudents">
                                Include Students
                            </label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IncludeParents" id="includeParents">
                            <label class="form-check-label" for="includeParents">
                                Include Parents
                            </label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IncludeSchoolContacts" id="includeSchoolContacts">
                            <label class="form-check-label" for="includeSchoolContacts">
                                Include ACCs
                            </label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IncludeClassroomTeachers" id="includeClassroomTeachers">
                            <label class="form-check-label" for="includeClassroomTeachers">
                                Include Classroom Teachers
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success show-loader">Send</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</form>
