@model Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.Components.UploadFileForImportStaging.UploadFileForImportStagingSelection;

<form asp-page-handler="ImportFile" method="post" enctype="multipart/form-data">
    <div class="modal fade" tabindex="-1" id="import-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Import Applications</h5>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="mb-3 col">
                            <label class="form-text">The upload file must be an Excel (.xlsx/.xls) file or a CSV (.csv) file.</label>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="mb-3 col">
                            <label asp-for="UploadFile" class="control-label">Import File</label>
                            <input asp-for="UploadFile" class="form-control" type="file"/>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="pull-right">
                        <button type="submit" class="btn btn-primary">Import</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

