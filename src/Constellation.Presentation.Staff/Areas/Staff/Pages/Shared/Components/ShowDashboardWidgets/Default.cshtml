@model List<DashboardWidgetModel>
@using Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.PartialViews.DashboardWidget

@foreach (DashboardWidgetModel card in Model)
{
    <partial name="Shared/PartialViews/DashboardWidget/DashboardWidget" model="card" />
}

<script>
    document.querySelectorAll('.dashboard-chart').forEach(function (canvas) {
        const labels = JSON.parse(canvas.dataset.labels);   // ["Preparing","Awaiting Response",...]
        const values = JSON.parse(canvas.dataset.values);    // [27, 2, 2, 1]
        const colors = ['#0d6efd', '#6c757d', '#ffc107', '#198754', '#dc3545'];

        new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: [''],               // one category = one bar/row
                datasets: labels.map((label, i) => ({
                    label: label,
                    data: [values[i]],       // this dataset contributes one value to the single bar
                    backgroundColor: colors[i % colors.length]
                }))
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { stacked: true },
                    y: { stacked: true, display: false } // hide the empty category label on the axis
                },
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    });
</script>