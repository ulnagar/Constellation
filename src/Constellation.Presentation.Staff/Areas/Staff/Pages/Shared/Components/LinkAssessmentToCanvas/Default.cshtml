@model Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.Components.LinkAssessmentToCanvas.LinkAssessmentToCanvasSelection

<div class="modal-dialog modal-lg">
    <div id="modal-content" class="modal-content">
        <form asp-page-handler="LinkCanvasAssignment">
            <div class="modal-header">
                <h5 class="modal-title">Link Canvas Assignment</h5>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="form-group col">
                        <label class="control-label">Assignment</label>
                        <select asp-for="SelectedAssessment" asp-items="Model.Courses" class="combo" style="width:100%">
                            <option value="">-- Select --</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="form-group col">
                        <label class="control-label">Forward Date</label>
                        <input asp-for="ForwardDate" class="form-control"/>
                        <span class="text-muted">The date that submissions should be forwarded to Canvas. To send submissions to Canvas immediately, set this date to today.</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <input type="submit" value="Save" class="btn btn-primary"/>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Close</button>
            </div>
        </form>
    </div>
</div>
