@model Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.Components.AddDownloadToAssessment.AddDownloadToAssessmentSelection

<form asp-page-handler="AddDownload" method="post" enctype="multipart/form-data">
    <div class="modal fade" tabindex="-1" id="upload-assessment-document-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Assessment Document</h5>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="mb-3 col">
                            <label asp-for="UploadFile" class="form-label">Document</label>
                            <input asp-for="UploadFile" class="form-control" type="file"/>
                            <div class="form-text"></div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="mb-3 col">
                            <label asp-for="Name" class="form-label">Document Title</label>
                            <input asp-for="Name" class="form-control" />
                            <div class="form-text"></div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="mb-3 col">
                            <label asp-for="AvailableFrom" class="form-label">Available From</label>
                            <input asp-for="AvailableFrom" class="form-control" />
                            <div class="form-text"></div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="mb-3 col">
                            <label asp-for="AvailableTo" class="form-label">Available Until</label>
                            <input asp-for="AvailableTo" class="form-control" />
                            <div class="form-text"></div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="mb-3 col">
                            <div class="form-check form-switch">
                                <input asp-for="IsRestricted" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsRestricted" class="form-check-label">Is Restricted?</label>
                                <div class="form-text">Restricted files will be visible only to ACCs</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="pull-right">
                        <button type="submit" class="btn btn-primary">Upload</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

