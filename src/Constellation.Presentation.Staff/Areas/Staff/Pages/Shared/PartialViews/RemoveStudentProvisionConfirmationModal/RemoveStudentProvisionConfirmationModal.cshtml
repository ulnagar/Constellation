@model Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.PartialViews.RemoveStudentProvisionConfirmationModal.RemoveStudentProvisionConfirmationModalViewModel

<div class="modal-header">
    <h5 class="modal-title">Remove Provision</h5>
</div>
<div class="modal-body">
    <div class="row">
        <div class="form-group col">
            <span class="control-label">Are you sure you wish to remove the "@Model.Provision.Code - @Model.Provision.Description" provision from @Model.Provision.Student.DisplayName?</span>
        </div>
    </div>
</div>
<div class="modal-footer">
    <a asp-page-handler="RemoveProvision" asp-route-studentProvisionId="@Model.Provision.Id" class="btn btn-danger show-loader">Remove Provision</a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>