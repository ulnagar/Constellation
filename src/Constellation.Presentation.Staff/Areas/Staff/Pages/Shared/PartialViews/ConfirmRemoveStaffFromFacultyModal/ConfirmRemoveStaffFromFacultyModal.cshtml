@model Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.PartialViews.ConfirmRemoveStaffFromFacultyModal.ConfirmRemoveStaffFromFacultyModalViewModel

<form asp-page-handler="RemoveMember" method="post">
    <div class="modal-header">
        <h5 class="modal-title">Remove Staff Member</h5>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="form-group col">
                <span class="control-label">Are you sure you wish to remove @Model.StaffName from the Faculty?</span>
                <input type="hidden" asp-for="StaffId" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-danger show-loader">Remove</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</form>