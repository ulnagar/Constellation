@model Constellation.Presentation.Staff.Areas.Staff.Pages.Shared.PartialViews.UpsertAssessmentInstructions.UpsertAssessmentInstructionsViewModel

<form asp-page-handler="UpsertInstructions" method="post">
    <div class="modal-header">
        <h5 class="modal-title">Add Instructions</h5>
    </div>
    <div class="modal-body">
        <div class="form-group row mb-3">
            <label class="col-12">Category</label>
            <div class="col-12">
                <input type="hidden" asp-for="Category" />
                @Model.Category.Name
            </div>
        </div>

        <div class="form-group row">
            <label class="col-12">Instructions</label>
            <div class="col-12">
                <textarea asp-for="Instructions" class="form-control summernote" cols="100" rows="5"></textarea>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-success">Add Instructions</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</form>