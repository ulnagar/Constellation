@section scripts {
    <script>
        // ─── Modal openers ────────────────────────────────────────────────────────
        const modalTriggers = {
            'ShowGradeSelectList':    'GradeListModal',
            'ShowSchoolSelectList':   'SchoolListModal',
            'ShowClassSelectList':    'ClassListModal',
            'ShowCourseSelectList':   'CourseListModal',
            'ShowCategorySelectList': 'CategoryListModal',
            'ShowFlagSelectList':     'FlagListModal'
        };

        Object.entries(modalTriggers).forEach(([btnId, modalId]) => {
            $(`#${btnId}`).on('click', () => $(`#${modalId}`).modal('show'));
        });

        // ─── Filter form submission ───────────────────────────────────────────────
        $('#SubmitFormAsFilter').on('click', function () {
            showLoader();
            $('#filterAction').val(0);
            $('#filterForm').submit();
        });

        $('#SubmitFormAsExport').on('click', function () {
            showLoader();
            $('#filterAction').val(1);
            $('#filterForm').submit();
        });

        // ─── School select2 ───────────────────────────────────────────────────────
        const $schoolOption = $('#custom-combo').select2({ 
                theme: 'bootstrap-5',
                dropdownParent: $('#SchoolListModal')
            });

        $schoolOption.on('select2:select select2:unselect', function (e) {
            toggleSchool(e.params.data.id);
        });
        
        // ─── Generic filter toggle ────────────────────────────────────────────────
        // Uses document.getElementById to safely handle values containing CSS
        // special characters (e.g. dots in category/flag names).
        function toggleItem(prefix, value, pageSelector, modalSelector, inputName) {
            const id = `${prefix}-${value}`;
            const $btn = $(document.getElementById(id));
            const isSelected = $btn.hasClass('btn-info');

            $btn.toggleClass('btn-info', !isSelected)
                .toggleClass('btn-outline-info', isSelected);

            if (isSelected) {
                [`pd-${id}`, `md-${id}`, `i-${id}`].forEach(elemId => document.getElementById(elemId)?.remove());
            } else {
                $btn.clone().prop('id', `pd-${id}`).appendTo(pageSelector);
                $btn.clone().prop('id', `md-${id}`).appendTo(modalSelector);
                $('<input>').attr({ id: `i-${id}`, name: inputName, type: 'hidden' })
                    .val(value)
                    .appendTo(pageSelector);
            }
        }

        function toggleGrade(grade)     { toggleItem('gradeSelect',    grade,    '#SelectedGradesList',     '#ModalSelectedGradesList',     'Filter.Grades'); }
        function toggleSchool(code)     { toggleItem('schoolSelect',   code,     '#SelectedSchoolsList',    '#ModalSelectedSchoolsList',    'Filter.SchoolCodes'); }
        function toggleClass(id)        { toggleItem('offeringSelect', id,       '#SelectedClassesList',    '#ModalSelectedClassesList',    'Filter.OfferingIds'); }
        function toggleCourse(courseId) { toggleItem('courseSelect',   courseId, '#SelectedCoursesList',    '#ModalSelectedCoursesList',    'Filter.CourseIds'); }
        function toggleFlag(value)      { toggleItem('flagSelect',     value,    '#SelectedFlagsList',      '#ModalSelectedFlagsList',      'Filter.Flags'); }
        function toggleCategory(value)  { toggleItem('categorySelect', value,    '#SelectedCategoriesList', '#ModalSelectedCategoriesList', 'Filter.Categories'); }

        // ─── Restore filter state on page load ───────────────────────────────────
        $(document).ready(function () {
            @foreach (var grade in Model.Filter.Grades)
            {
                @:toggleGrade('@grade');
            }

            @foreach (var category in Model.Filter.Categories) 
            {
                @:toggleCategory('@category.Value'); 
            }

            @foreach (var offering in Model.Filter.OfferingIds)
            {
                @:toggleClass('@offering.Value'); 
            }

            @foreach (var course in Model.Filter.CourseIds)    
            { 
                @:toggleCourse('@course.Value'); 
            }

            @foreach (var school in Model.Filter.SchoolCodes) 
            {
                @:toggleSchool('@school'); 
            }

            @foreach (var flag in Model.Filter.Flags)          
            { 
                @:toggleFlag('@flag'); 
            }
        });

        // ─── DataTable ────────────────────────────────────────────────────────────
        const table = $('.custom-data-table').DataTable({
            order: [],
            rowGroup: { dataSrc: 0 },
            columnDefs: [{ visible: false, targets: 0 }]
        });

        // ─── Send Email ───────────────────────────────────────────────────────────
        $('#SendEmail').on('click', async function () {
            toggleLoader();
            const recipients = getRecipientsFromTable();

            if (recipients.length === 0) {
                alert('No recipients found.');
                return;
            }

            const response = await fetch('?handler=AddRecipients', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ recipients })
            });

            if (response.redirected) {
                window.location.href = response.url;
                return;
            }

            $(makeModal('<p>The details of all contacts in the table displayed below have been added to your draft message.</p><p>Please use the Messaging module to send your message.</p>'))
                .modal('show');
            toggleLoader();
        });

        function getRecipientsFromTable() {
            const recipients = [];

            // rows({ search: 'applied' }) respects the current DataTable filter/search state
            table.rows({ search: 'applied' }).every(function () {
                const row = this.node();
                recipients.push({
                    name:         $('td:eq(2)', row).text().trim().split('\n')[0].trim().replace(/\s*\(.*$/, ''),
                    emailAddress: { value: $('td:eq(3)', row).text().trim() },
                    phoneNumber:  { value: $('td:eq(4)', row).text().trim() }
                });
            });

            return recipients;
        }

        function makeModal(message) {
            return `
                <div class="modal fade" id="dummyModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Alert!</h5>
                            </div>
                            <div class="modal-body">${message}</div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>`;
        }

        // ─── Phone number update ──────────────────────────────────────────────────
        let activePhoneHandler = '';
        let clickedRow = null;

        function openPhoneModal($btn, handler, paramName) {
            clickedRow = $btn.closest('tr');
            $.ajax({
                url: `?handler=${handler}`,
                type: 'POST',
                data: {
                    [paramName]: $btn.data('id'),
                    __RequestVerificationToken: $('input:hidden[name="__RequestVerificationToken"]').val()
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        }

        $('#contacts-table-container').on('click', '.staff-phone', function () {
            activePhoneHandler = 'StaffPhoneUpdate';
            openPhoneModal($(this), 'AjaxStaffPhoneUpdate', 'staffId');
        });

        $('#contacts-table-container').on('click', '.contact-phone', function () {
            activePhoneHandler = 'ContactPhoneUpdate';
            openPhoneModal($(this), 'AjaxContactPhoneUpdate', 'contactId');
        });

        // Intercept modal form submit — works for both staff and contact phone forms
        // without needing to modify either partial view.
        $('#page-modal').on('submit', 'form', function (e) {
            e.preventDefault();

            $.ajax({
                url: '?handler=' + activePhoneHandler,
                type: 'POST',
                data: $(this).serialize()
            }).done(function (result) {
                if (result.success) {
                    $('#page-modal').modal('hide');
                    table.cell(clickedRow, 5).data(result.phoneNumber).draw(false);
                    clickedRow = null;
                } else {
                    $('#page-modal .error-message').text(result.error).show();
                }
            }).fail(function () {
                $('#page-modal .error-message').text('An unexpected error occurred.').show();
            });
        });
    </script>
}