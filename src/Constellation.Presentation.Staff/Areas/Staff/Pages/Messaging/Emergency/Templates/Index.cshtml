@page
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Messaging.Emergency.Templates.IndexModel
@{
}

<h2>Message Templates</h2>

<div class="page-menu">
    <a asp-page="/Messaging/Emergency/Templates/Upsert" asp-area="Staff" class="btn btn-success">New</a>
</div>

<hr />

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Type</th>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var message in Model.Templates)
        {
            <tr>
                <td>@message.TemplateType.Name</td>
                <td>@message.Name</td>
                <td>
                    <a asp-page="/Messaging/Emergency/Templates/Upsert" asp-area="Staff" asp-route-id="@message.Id" class="btn btn-sm btn-warning btn-show-hover">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({
                "order": [
                    [1, 'asc']
                ]
            });
        })
    </script>
}
