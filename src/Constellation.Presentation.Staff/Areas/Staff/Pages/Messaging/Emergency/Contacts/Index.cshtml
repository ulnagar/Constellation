@page
@using Constellation.Application.Domains.Messaging.EmergencyConsole.Queries.GetContactDetails
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Messaging.Emergency.Contacts.IndexModel
@{
}

<h2>Emergency Contacts</h2>

<div class="page-menu">
    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right show-loader">Go Back</a>
</div>

<hr />

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Phone</th>
        <th>Email</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Contacts)
    {
        <tr>
            <td data-order="@item.Name.SortOrder">
                @item.Name.DisplayName<br/>
                @item.AdditionalDetail
            </td>
            <td data-order="@Enum.Format(typeof(ContactDetail.ContactCategory), item.Category, "d")">@item.Category</td>
            <td>@item.PhoneNumber</td>
            <td>@item.EmailAddress</td>
            <td>
                @if (item.Category == ContactDetail.ContactCategory.Staff)
                {
                    <button class="btn btn-sm btn-info btn-show-hover staff-phone" data-id="@item.Id">Update Phone</button>
                }
                
                @if (item.Category == ContactDetail.ContactCategory.Coordinator)
                {
                    <button class="btn btn-sm btn-info btn-show-hover contact-phone" data-id="@item.Id">Update Phone</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@Html.AntiForgeryToken()

@section scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({
                "order": [
                    [1, 'asc']
                ]
            });
        });

        $('.staff-phone').click(function (event) {
            var id = $(this).data("id");
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "?handler=AjaxStaffPhoneUpdate",
                type: "POST",
                data: {
                    staffId: id,
                    __RequestVerificationToken: xsrfHeader
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        });

                $('.contact-phone').click(function (event) {
            var id = $(this).data("id");
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "?handler=AjaxContactPhoneUpdate",
                type: "POST",
                data: {
                    contactId: id,
                    __RequestVerificationToken: xsrfHeader
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        });
    </script>
}