@page
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Messaging.History.RecentModel
@{
}

<h2>Recent Messages</h2>

<div class="row">
    <label class="mr-1 col-1">Date Range: </label>
    <div class="col">
        <select id="dateRangeFilter" class="form-select">
            <option value="Last30Days" selected>Last 30 Days</option>
            <option value="CurrentCalendarYear">This Year</option>
            <option value="AllTime">All Time</option>
        </select>
    </div>
</div>

<hr />

<table id="messagesTable" class="table table-striped" style="width:100%">
    <thead>
        <tr>
            <th>Type</th>
            <th>Timestamp</th>
            <th>From</th>
            <th>Recipients</th>
            <th>Subject</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
</table>

@section Scripts
{
    <script>
        $(function () {
            var table = $('#messagesTable').DataTable({
                serverSide: true,
                processing: true,
                ajax: {
                    url: '@Url.Page("/Messaging/History/Recent", "Data")',
                    type: 'GET',
                    data: function (d) {
                        d.dateRange = $('#dateRangeFilter').val();
                        d.searchValue = d.search.value;
                    }
                },
                order: [[1, 'desc']],
                columns: [
                    { data: 'typeIcon', render: function (icon) { return '<i class="' + icon +'"></i>'; } },
                    { data: 'timestamp' },
                    {
                        data: null,
                        render: function (row) {
                            return '<span title="' + row.fromContact + '" class="badge border border-secondary text-secondary text-nowrap">' + row.fromName + '</span>';
                        }
                    },
                    { data: 'recipientsHtml' },
                    { data: 'subject' },
                    { data: 'status' },
                    {
                        data: null,
                        render: function (row){
                            return '<a href="' + row.viewUrl + '" target="_blank" class="btn btn-secondary btn-sm btn-show-hover">ViewMessage</a>';
                        }
                    }
                ]
            });

            $('#dateRangeFilter').on('change', function () {
                table.ajax.reload();
            });
        });
    </script>
}
