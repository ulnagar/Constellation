@page
@using Constellation.Core.Extensions
@model Constellation.Presentation.Staff.Areas.Staff.Pages.StudentAdmin.Attendance.CheckIn.IndexModel
@{
}

<h2>Check In Responses</h2>

<div class="page-menu">

</div>

<hr />

<table class="table table-striped table-hover data-table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Grade</th>
            <th>School</th>
            <th>Class</th>
            <th>Sentiment</th>
            <th>Timestamp</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model.Responses)
        {
            <tr>
                <td data-order="@entry.Student.SortOrder" data-search="@entry.Student.DisplayName @entry.Student.FirstName">@entry.Student.DisplayName</td>
                <td data-order="@entry.Grade.AsNumber()">@entry.Grade.AsName()</td>
                <td data-search="@entry.SchoolCode">@entry.School</td>
                <td>@entry.Offering</td>
                <td>@entry.Sentiment</td>
                <td data-order="@entry.SubmittedAt.ToString("O")">@entry.SubmittedAt.ToString("g")</td>
            </tr>
        }
    </tbody>
</table>