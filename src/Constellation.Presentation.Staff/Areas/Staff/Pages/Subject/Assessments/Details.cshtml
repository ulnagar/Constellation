@page "{id}"
@using Constellation.Core.Extensions
@using Constellation.Core.Models.Assessments.Enums
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Subject.Assessments.DetailsModel

@inject IAuthorizationService AuthorizationService
@{
    var canEditTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Subjects_Assessments_Edit_Value);
    var canEditProvisionsTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Subjects_AssessmentsProvisions_Assign_Value);
}

<h2>Assessment Details</h2>

<div class="page-menu">
    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />

<div class="row">
    <div class="col-6">
        <dl class="row">
            <dt class="col-md-3">
                <label asp-for="Assessment.Name">Name</label>
            </dt>
            <dd class="col-md-9">
                <span>@Model.Assessment.Name</span>
            </dd>

            <dt class="col-md-3">
                <label asp-for="Assessment.Course">Course</label>
            </dt>
            <dd class="col-md-9">
                <span>@Model.Assessment.Course</span>
            </dd>

            <dt class="col-md-3">
                <label asp-for="Assessment.DueDate">Due Date</label>
            </dt>
            <dd class="col-md-9">
                <span>@Model.Assessment.DueDate.LocalDateTime.ToString("D") @Model.Assessment.DueDate.LocalDateTime.ToString("h:mm tt")</span>
            </dd>

            <dt class="col-md-3">
                <label asp-for="Assessment.AvailableFrom">Available From</label>
            </dt>
            <dd class="col-md-9">
                <span>@Model.Assessment.AvailableFrom.LocalDateTime.ToString("D") @Model.Assessment.AvailableFrom.LocalDateTime.ToString("h:mm tt")</span>
            </dd>

            <dt class="col-md-3">
                <label asp-for="Assessment.AvailableTo">Available To</label>
            </dt>
            <dd class="col-md-9">
                <span>@Model.Assessment.AvailableTo.LocalDateTime.ToString("D") @Model.Assessment.AvailableTo.LocalDateTime.ToString("h:mm tt")</span>
            </dd>
        </dl>
    </div>

    <div class="col-6">
        <div class="row">
            <div class="col-md-6">
                <button class="btn btn-success link-canvas-btn">Link Canvas Assignment</button>
            </div>
        </div>
        <dl class="row">
            <dt class="col-md-3">Linked to Canvas?</dt>
            <dd class="col-md-9">
                <span>@Model.Assessment.IsLinkedToCanvasAssignment</span>
            </dd>
        </dl>
    </div>
</div>

<hr />

<div>
    <nav class="navbar navbar-expand-xl navbar-toggleable-xl navbar-dark bg-success bg-gradient local-nav">
        <div class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
            <ul class="nav navbar-nav flex-grow-1 me-auto ms-3 mb-2">
                <li class="nav-item">
                    <a class="nav-link active" href="#students" data-bs-toggle="tab" role="tab">Students</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#instructions" data-bs-toggle="tab" role="tab">Instructions</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#downloads" data-bs-toggle="tab" role="tab">Downloads</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#submissions" data-bs-toggle="tab" role="tab">Submissions</a>
                </li>
            </ul>
        </div>
    </nav>
    
    <div class="tab-content">
        <div id="students" class="tab-pane active">
            <h3>Students</h3>
            
            @if (canEditTest.Succeeded)
            {
                <button data-bs-toggle="modal" data-bs-target="#add-student-modal" class="btn btn-success">Add Student</button>
            }

            <table class="table table-striped table-hover students-table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Grade</th>
                    <th>School</th>
                    <th>Provisions</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model.Assessment.Students.Where(student => !student.IsDeleted))
                {
                    <tr>
                        <td data-order="@entry.StudentName.SortOrder" data-search="@entry.StudentName.DisplayName @entry.StudentName.FirstName">@entry.StudentName</td>
                        <td data-order="@entry.StudentGrade.AsNumber()">@entry.StudentGrade.AsName()</td>
                        <td>@entry.SchoolName</td>
                        <td>
                            @foreach (var provision in entry.Provisions)
                            {
                                <button class="btn btn-sm btn-primary mb-1">@provision</button>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-warning dropdown-toggle btn-sm btn-show-hover" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> Actions</button>
                                <div class="dropdown-menu">
                                    @if (canEditProvisionsTest.Succeeded)
                                    {
                                        <button class="dropdown-item add-provision-button" data-id="@entry.StudentId">Add Provision</button>
                                    }
                                        
                                    @if (canEditTest.Succeeded)
                                    {
                                        <button class="dropdown-item remove-student-button" data-id="@entry.StudentId">Remove Student</button>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        
        <div id="instructions" class="tab-pane">
            <h3>Instructions</h3>

            <div class="row">
                @foreach (var category in UserCategory.GetOptions)
                {
                    var instruction = Model.Assessment.Instructions.FirstOrDefault(entry => entry.Category == category);

                    <div class="col-4">
                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title">@category.Name</h4>
                            </div>
                            <div class="card-body">
                                @Html.Raw(instruction?.Description)
                            </div>
                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-6 d-grid">
                                        @if (instruction is null)
                                        {
                                            <button class="btn btn-primary instruction-update-button" data-id="" data-category="@category">Create</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary instruction-update-button" data-id="@instruction.InstructionId" data-category="@category">Edit</button>
                                        }
                                    </div>
                                    <div class="col-6 d-grid">
                                        @if (instruction is not null)
                                        {
                                            <button class="btn btn-danger instruction-delete-button" data-id="@instruction.InstructionId">Delete</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    
        <div id="downloads" class="tab-pane">
            <h3>Downloads</h3>
            
            @if (canEditTest.Succeeded)
            {
                <button data-bs-toggle="modal" data-bs-target="#upload-assessment-document-modal" class="btn btn-success">Add Document</button>
            }

            <table class="table table-striped downloads-table">
                <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Available From</th>
                    <th>Available To</th>
                    <th>Restricted?</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model.Assessment.Downloads)
                {
                    <tr data-id="@entry.DownloadId">
                        <td></td>
                        <td>@entry.Name</td>
                        <td data-order="@entry.AvailableFrom.ToString("yyyy-MM-dd")">@entry.AvailableFrom.ToString("d")</td>
                        <td data-order="@entry.AvailableTo.ToString("yyyy-MM-dd")">@entry.AvailableTo.ToString("d")</td>
                        <td>
                            @if (entry.IsRestricted)
                            {
                                <span class="badge bg-danger">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-warning dropdown-toggle btn-sm btn-show-hover" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> Actions</button>
                                <div class="dropdown-menu">
                                    <a asp-page-handler="DownloadFile" class="dropdown-item" asp-route-downloadId="@entry.DownloadId">Download</a>

                                    @if (canEditTest.Succeeded)
                                    {
                                        <button class="dropdown-item remove-document-button" data-id="@entry.DownloadId">Remove Document</button>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            
            <div id="download-child-content" class="hidden">
                @foreach (var entry in Model.Assessment.Downloads)
                {
                    <div data-id="@entry.DownloadId">
                        <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Downloaded On</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in entry.DownloadEvents)
                            {
                                <tr>
                                    <td>@item.User</td>
                                    <td>@item.Email</td>
                                    <td>@item.DownloadedOn.LocalDateTime.ToString("g")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    
        <div id="submissions" class="tab-pane">
            <h3>Submissions</h3>
            
            @if (canEditTest.Succeeded)
            {
                <button data-bs-toggle="modal" data-bs-target="#upload-assessment-submission-modal" class="btn btn-success">Add Submission</button>
                <a asp-page-handler="DownloadAllSubmissions" class="btn btn-warning">Download All</a>
            }

            <table class="table table-striped table-hover submissions-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Submitted At</th>
                        <th>Submitted By</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Assessment.Submissions)
                    {
                        var student = Model.Assessment.Students.FirstOrDefault(student => student.StudentId == entry.StudentId);

                        <tr>
                            <td data-order="@(student?.StudentName.SortOrder ?? "zzzUnknown")">@(student?.StudentName.DisplayName ?? "Unknown Student")</td>
                            <td data-order="@entry.SubmittedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")">@entry.SubmittedAt.LocalDateTime.ToString("g")</td>
                            <td>@entry.SubmittedBy</td>
                            <td>
                                @if (canEditTest.Succeeded)
                                {
                                    <a asp-page-handler="DownloadSubmission" asp-route-submissionId="@entry.SubmissionId" class="btn btn-warning btn-sm btn-show-hover">Download</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
      
<vc:add-student-to-assessment id="Model.Id" />
<vc:add-download-to-assessment 
    available-from="Model.Assessment.AvailableFrom" 
    available-to="Model.Assessment.AvailableTo" />
<vc:add-submission-to-assessment assessment-id="Model.Id" />

<div class="modal fade" tabindex="-1" id="link-canvas-modal">
    <div class="modal-dialog modal-lg">
        <div id="modal-content" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Link Canvas Assignment</h5>
            </div>
            <div class="modal-body">
                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts
{
    <script>
        $(document).ready(function (){
            DataTable.types().forEach(type => {
                DataTable.type(type, 'detect', () => false);
            });

            $('.data-table').DataTable({
                "order": [
                    [0, 'asc']
                ]
            });

            $('.students-table').DataTable({
                "order": [
                    [0, 'asc']
                ],
                "columnDefs": [
                    { width: '40%', targets: 3 },
                    { searchable: false, sortable: false, targets: 4 }
                ]
            });

            $('.submissions-table').DataTable({
                "order": [
                    [0, 'asc'],
                    [1, 'desc']
                ],
                "columnDefs": [
                    { searchable: false, sortable: false, targets: 3 }
                ]
            });

            let downloadTable = $('.downloads-table').DataTable({
                "order": [
                    [1, 'asc']
                ],
                "columnDefs": [
                    { className: 'dt-control', orderable: false, data: null, defaultContent: '', targets: 0 },
                    { orderable: false, targets: 5 }
                ]
            });

            downloadTable.on('click', 'tbody td.dt-control', function (e) {
                let tr = e.target.closest('tr');
                let row = downloadTable.row(tr);
                let id = $(tr).data('id');
                let source = $(`#download-child-content [data-id="${id}"]`)
 
                if (row.child.isShown()) {
                    // This row is already open - close it
                    row.child.hide();
                }
                else {
                    // Open this row
                    row.child(source.clone()).show();
                }
            });
        });

        $('.link-canvas-btn').on('click', function () {
            const $modal = $('#link-canvas-modal');
            const $container = $('#link-canvas-modal .modal-body');

            // Only fetch if not already loaded
            if ($container.data('loaded')) {
                $modal.modal('show');
                return;
            }

            showLoader();

            $.get('?handler=AjaxLoadCanvasAssignments', function (html) {
                $container.html(html);
                $container.data('loaded', true);
                $modal.modal('show');
                toggleLoader();
            });
        });

        $('.instruction-update-button').click(function (event) {
            var instructionId = $(this).data('id') || null;
            var category = $(this).data('category');
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "?handler=AjaxUpdateInstructions",
                type: "POST",
                headers: {
                    "RequestVerificationToken": xsrfHeader
                },
                data: {
                    instructionId,
                    category
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal .summernote').summernote({
                    height: 300,
                    toolbar: [
                        // [groupName, [list of button]]
                        ['style', ['bold', 'italic', 'underline', 'clear']],
                        ['font', ['strikethrough', 'superscript', 'subscript']],
                        ['fontsize', ['fontsize']],
                        ['color', ['color']],
                        ['para', ['ul', 'ol', 'paragraph']],
                        ['insert', ['link']],
                        ['height', ['height']]
                    ]
                });
                $('#page-modal').modal('show');
            });
        });

        $('.instruction-delete-button').click(function (event) {
            var instructionId = $(this).data('id');
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "?handler=AjaxRemoveInstruction",
                type: "POST",
                data: {
                    instructionId,
                    __RequestVerificationToken: xsrfHeader
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        });

        $('.remove-student-button').click(function (event) {
            var studentId = $(this).data("id");
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "?handler=AjaxRemoveStudent",
                type: "POST",
                data: {
                    studentId: studentId,
                    __RequestVerificationToken: xsrfHeader
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        });
        
        $('.remove-document-button').click(function (event) {
            var documentId = $(this).data("id");
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "?handler=AjaxRemoveDocument",
                type: "POST",
                data: {
                    documentId: documentId,
                    __RequestVerificationToken: xsrfHeader
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        });

        $('.add-provision-button').click(function (event) {
            var studentId = $(this).data("id");
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();
            
            $.ajax({
                url: "?handler=AjaxAddProvision",
                type: "POST",
                data: {
                    studentId: studentId,
                    __RequestVerificationToken: xsrfHeader
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        });

        function toggleProvision(value) {
            const id = `provisionSelect-${value}`;
            const $btn = $(document.getElementById(id));
            const isSelected = $btn.hasClass('btn-info');
            const modalSelector = '#ModalSelectedPrivisionList';
            const inputName = "Provisions";

            $btn.toggleClass('btn-info', !isSelected)
                .toggleClass('btn-outline-info', isSelected);

            if (isSelected) {
                [`md-${id}`, `i-${id}`].forEach(elemId => document.getElementById(elemId)?.remove());
            } else {
                $btn.clone().prop('id', `md-${id}`).appendTo(modalSelector);
                $('<input>').attr({ id: `i-${id}`, name: inputName, type: 'hidden' })
                    .val(value)
                    .appendTo(modalSelector);
            }
        }
    </script>
}