@page "{id?}"
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Subject.Assessments.UpsertModel

@{
}

<h2>Edit Assessment</h2>

<div class="page-menu">
    <a asp-page="/Subject/Assessments/Index" asp-area="Staff" class="btn btn-danger btn-pull-right">Go Back</a>
</div>

<hr />

<form method="post">
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3 row">
            <label asp-for="Name" class="col-md-2">Assessment Name</label>
            <div class="col-md-5">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        
        <div class="mb-3 row">
            <label asp-for="CourseId" class="col-md-2">Course</label>
            <div class="col-md-5">
                <select asp-for="CourseId" asp-items="@Model.CourseList" class="form-control combo">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <label asp-for="DueDate" class="col-md-2">Due Date</label>
            <div class="col-md-5">
                <input asp-for="DueDate" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>
        </div>
        
        <div class="mb-3 row">
            <label asp-for="AvailableFrom" class="col-md-2">Available From</label>
            <div class="col-md-5">
                <input asp-for="AvailableFrom" class="form-control" />
                <span asp-validation-for="AvailableFrom" class="text-danger">The date at which the assessment will be visible in to ACCs, Parents, and Students.</span>
            </div>
        </div>
        
        <div class="mb-3 row">
            <label asp-for="AvailableTo" class="col-md-2">Available To</label>
            <div class="col-md-5">
                <input asp-for="AvailableTo" class="form-control" />
                <span asp-validation-for="AvailableTo" class="text-danger">The date at which the assessment will no longer be visible to ACCs, Parents, and Students.</span>
            </div>
        </div>

        <div class="mb-3">
            <div class="col-md-3 d-grid">
                <input type="submit" value="Save" class="btn btn-primary btn-block btn-lg" />
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}