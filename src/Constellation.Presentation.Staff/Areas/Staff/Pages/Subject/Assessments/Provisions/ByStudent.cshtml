@page
@model Constellation.Presentation.Staff.Areas.Staff.Pages.Subject.Assessments.Provisions.ByStudentModel

@using Constellation.Presentation.Staff.Areas.Staff.Pages.Subject.Assessments.Provisions

@inject IAuthorizationService AuthorizationService
@{
    var canAssignTest = await AuthorizationService.AuthorizeAsync(User, AuthPermission.Subjects_AssessmentsProvisions_Assign_Value);
    var currentYear = DateTime.Today.Year;
}

<h2>Student Provisions</h2>

<div class="page-menu">
    @{
        var all_style = "btn-outline-secondary";
        var current_style = all_style;

        switch (Model.Filter)
        {
            case ByStudentModel.ProvisionFilter.All:
                all_style = "btn-primary";
                break;
            case ByStudentModel.ProvisionFilter.Current:
                current_style = "btn-primary";
                break;
        }
    }

    <div class="btn-group">
        <a asp-page="/Subject/Assessments/Provisions/ByStudent" asp-area="Staff" asp-route-filter="@ByStudentModel.ProvisionFilter.All" class="btn @all_style">All</a>
        <a asp-page="/Subject/Assessments/Provisions/ByStudent" asp-area="Staff" asp-route-filter="@ByStudentModel.ProvisionFilter.Current" class="btn @current_style">Current</a>
    </div>
    
    @if (canAssignTest.Succeeded)
    {
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#assign-provision-modal">Assign Provision</button>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#bulk-import-modal">Bulk Import</button>
    }
</div>

<hr />

<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Student</th>
        <th>Year</th>
        <th>Provisions</th>
    </tr>
    </thead>
    <tbody>
    @{
        var byStudent = Model.Provisions.GroupBy(provision => provision.Student);

        foreach (var student in byStudent)
        {
            var byYear = student.GroupBy(provision => provision.Year).OrderByDescending(group => group.Key);

            foreach (var year in byYear)
            {
                <tr>
                    <td data-order="@student.Key.SortOrder" data-search="@student.Key.DisplayName @student.Key.FirstName">@student.Key.DisplayName</td>
                    <td>@year.Key</td>
                    <td>
                        @foreach (var provision in year.OrderBy(provision => provision.IsDeleted).ThenBy(provision => provision.Code))
                        {
                            if (provision.IsDeleted)
                            {
                                <button class="btn btn-sm btn-secondary me-1">@provision.Code : @provision.Description</button>
                            }
                            else if (canAssignTest.Succeeded && year.Key == currentYear)
                            {
                                <button class="btn btn-sm btn-primary me-1 remove-provision-button" data-student-provision-id="@provision.Id">@provision.Code : @provision.Description</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-primary me-1">@provision.Code : @provision.Description</button>
                            }
                        }
                    </td>
                </tr>
            }
        }
    }
    </tbody>
</table>

@if (canAssignTest.Succeeded)
{
    <vc:assign-student-provision/>
    <vc:bulk-import-student-provisions />
}

@section Scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({
                order: [
                    [0, 'asc'],
                    [1, 'desc']
                ],
                rowGroup: { 
                    dataSrc: '0.display',
                    emptyDataGroup: 'Unknown'
                },
                columnDefs: [
                    { target: 0, visible: false, searchable: true }
                ]
            });
        })

        $('.remove-provision-button').click(function (event) {
            var studentProvisionId = $(this).data("studentProvisionId");
            var xsrfHeader = $('input:hidden[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: "?handler=AjaxRemoveProvision",
                type: "POST",
                data: {
                    studentProvisionId: studentProvisionId,
                    __RequestVerificationToken: xsrfHeader
                }
            }).done(function (data) {
                $('#page-modal .modal-content').html(data);
                $('#page-modal').modal('show');
            });
        });
    </script>
}