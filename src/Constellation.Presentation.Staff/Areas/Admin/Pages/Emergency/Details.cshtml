@page "{id}"
@using Constellation.Core.Models.EmergencyConsole.Enums
@model Constellation.Presentation.Staff.Areas.Admin.Pages.Emergency.DetailsModel
@{
}

<h2>MessageEvent Details</h2>

<div class="page-menu">
    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right show-loader">Go Back</a>
</div>

<hr />

<div>
    <dl class="row">
        <dt class="col-md-2">
            <label asp-for="MessageEvent.SentAt">Sent</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.MessageEvent.SentAt.ToString("f")</span>
        </dd>

        <dt class="col-md-2">
            <label asp-for="MessageEvent.SentBy">Sent By</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.MessageEvent.SentBy</span>
        </dd>

        <dt class="col-md-2">
            <label asp-for="MessageEvent">MessageEvent</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.MessageEvent.Message</span>
        </dd>
    </dl>
</div>

<hr />

<h3>Recipients</h3>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Recipient</th>
            <th>Status</th>
            <th>MessageEvent Type</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.MessageEvent.Recipient)
    {
        <tr>
            <td>
                @item.RecipientName<br />
                @item.RecipientAddress
            </td>
            <td>
                @if (item.Status == MessageStatus.Pending)
                {
                    <span class="badge bg-secondary">Pending</span>
                }
                else if (item.Status == MessageStatus.Sent)
                {
                    <span class="badge bg-primary">Sent</span>
                }
                else if (item.Status == MessageStatus.Delivered)
                {
                    <span class="badge bg-success">Delivered</span>
                }
                else if (item.Status == MessageStatus.Error)
                {
                    <span class="badge bg-danger">Error</span>
                }
            </td>
            <td>
                @item.Type.Name
            </td>
        </tr>
    }
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({
                "order": [
                    [0, 'asc']
                ]
            });
        })
    </script>
}