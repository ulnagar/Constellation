@page "{id}"
@model Constellation.Presentation.Staff.Areas.Admin.Pages.Emergency.DetailsModel
@{
}

<h2>Message Details</h2>

<div class="page-menu">
    <a href="javascript:history.go(-1)" class="btn btn-danger btn-pull-right show-loader">Go Back</a>
</div>

<hr />

<div>
    <dl class="row">
        <dt class="col-md-2">
            <label asp-for="Message.SentAt">Sent</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.Message.SentAt.ToString("f")</span>
        </dd>

        <dt class="col-md-2">
            <label asp-for="Message.SentBy">Sent By</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.Message.SentBy</span>
        </dd>

        <dt class="col-md-2">
            <label asp-for="Message">Message</label>
        </dt>
        <dd class="col-md-10">
            <span>@Model.Message.Message</span>
        </dd>
    </dl>
</div>

<hr />

<h3>Recipients</h3>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Recipient</th>
            <th>Status</th>
            <th>Message Type</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Message.Recipient)
    {
        <tr>
            <td>
                @item.RecipientName<br />
                @item.RecipientAddress
            </td>
            <td>
                @if (item.Sent)
                {
                    <span class="badge bg-info">Yes</span> 
                }
                else
                {
                    <span class="badge bg-warning">No</span>
                }
            </td>
            <td>
                @item.Type.Name
            </td>
        </tr>
    }
    </tbody>
</table>

@section scripts
{
    <script>
        $(document).ready(function (){
            $('table').DataTable({
                "order": [
                    [0, 'asc']
                ]
            });
        })
    </script>
}