@using Constellation.Infrastructure.Templates.Views.Emails.Auth
@model EnrolmentPortalEmailLoginEmailViewModel

@{
	Layout = "/Views/Shared/EmailLayout.cshtml";

	ViewData["Preheader"] = Model.Preheader;
	ViewData["Title"] = Model.Title;
	ViewData["SenderName"] = Model.SenderName;
	ViewData["SenderTitle"] = Model.SenderTitle;
}

<p>Dear @Model.Name.ToString()</p>

<p>We received a request to log in to your Aurora College Enrolments Portal account. To complete your login, please click the link below:</p>

<a href="@Model.Link" target="_blank">Complete Login</a>

<p>Please be advised that this link will expire in 24 hours and can only be used once. Once it has expired or been used, you will need to request a new login link.</p>

<p>If you did not request this login, no action is required and you may disregard this message. Your account will not be accessed without this link. Please do not forward this email, as anyone with the link can log in to your account.</p>

<p>Should you require any assistance, please contact Aurora College on 1300 610 733 or email <a href="mailto:support@aurora.nsw.edu.au">support@aurora.nsw.edu.au</a>.</p>