@model Constellation.Infrastructure.Templates.Views.Emails.Assessments.AssessmentSubmissionReceiptEmailViewModel

@{
    Layout = "/Views/Shared/EmailLayout.cshtml";

    ViewData["Preheader"] = Model.Preheader;
    ViewData["Title"] = Model.Title;
    ViewData["SenderName"] = Model.SenderName;
    ViewData["SenderTitle"] = Model.SenderTitle;
}

<h3>Assessment Submission Receipt</h3>

<p>This email confirms that Aurora College has received an upload with the following details:</p>

<dl>
    <dt>Student</dt>
    <dd>@Model.StudentName</dd>
    <dt>Subject</dt>
    <dd>@Model.CourseName</dd>
    <dt>Assignment</dt>
    <dd>@Model.AssignmentName</dd>
    <dt>Submitted On</dt>
    <dd>@Model.SubmittedOn.ToLongDateString()</dd>
    <dt>Receipt Id</dt>
    <dd>@Model.SubmissionId.ToString()</dd>
</dl>