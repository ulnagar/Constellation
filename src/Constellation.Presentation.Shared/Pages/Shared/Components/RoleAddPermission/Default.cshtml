@model Constellation.Presentation.Shared.Pages.Shared.Components.RoleAddUPermission.RoleAddPermissionSelection

<form asp-page-handler="AddPermission" id="addPermissionForm">
    <div class="modal fade" tabindex="-1" id="addPermissionModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Permission</h5>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="row">
                            <label asp-for="Permission">User</label>
                            <div class="w-100 col">
                                <select asp-for="Permission" class="combo w-100">
                                    <option value="">-- Select --</option>
                                    @foreach (var entry in Model.Permissions)
                                    {
                                        if (entry.Available)
                                        {
                                            <option value="@entry.Permission.Value">@entry.Permission.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@entry.Permission.Value" disabled="disabled">@entry.Permission.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </div>
    </div>
</form>
