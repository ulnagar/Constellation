@page
@model Constellation.Presentation.Enrolments.Areas.Enrolments.Pages.Account.RegisterModel

@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	@await Html.PartialAsync("_FavIcons")
	<title>Aurora College Enrolments</title>
	<link rel="stylesheet" href="~/lib/bootstrap5/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/glyphicon.css" />
	<link rel="stylesheet" href="~/css/login.css" />
	
	<style>
		.form-box {
			height: 700px;
		}

		.form-value > button,
		.form-value > .button {
			margin-bottom: 1rem;
		}
		
		.inputbox span.glyphicon-registration-mark {
			position: absolute;
			z-index: 2;
			pointer-events: auto;
			color: #9f0101;
		}

		.button {
			display: flex;
			align-items: center; /* vertical centering */
			justify-content: center; /* horizontal centering */
			box-sizing: border-box;
			margin: 0;
			width: 100%;
			height: 40px;
			border-radius: 40px;
			background: #fff;
			border: none;
			outline: none;
			cursor: pointer;
			font-family: inherit;
			font-size: 1em;
			font-weight: 600;
			line-height: normal;
			text-align: center;
			text-decoration: none; /* removes the link underline */
			text-transform: none;
			color: black;
		}

			.button:hover,
			.button:focus,
			.button:visited {
				color: black;
				text-decoration: none;
			}

		@@media (max-width: 830px) {
			.title-box {
				max-width: 75%;
				width: 75%;
			}

				.title-box .title {
					text-align: center;
				}

					.title-box .title h1 {
						font-size: 4rem;
						line-height: revert;
					}
		}

		@@media (max-width: 520px) {
			.title-box {
				max-width: 90%;
				width: 90%;
			}

				.title-box .title h1 {
					font-size: 3rem;
					line-height: revert;
				}
		}

		@@media (max-width: 420px) {
			.school-name {
				display: none;
			}
		}
	</style>
</head>
<body style="padding: 0; margin: 0;">
	<section>
		<div class="title-box">
			<div class="title-container">
				<div class="title">
					<h1><span class="school-name">Aurora College </span>Enrolments</h1>
				</div>
			</div>
		</div>

		<form>
			<div class="content-box">
				<div class="form-box">
					<div class="form-value">
						<h2>Register an account</h2>
				
						<div class="inputbox">
							<span class="glyphicon glyphicon-registration-mark" title="Required" aria-hidden="true"></span>
							<input asp-for="FirstName"/>
							<label asp-for="FirstName">First Name</label>
							<span asp-validation-for="FirstName" class="text-danger"></span>
						</div>
					
						<div class="inputbox">
							<input asp-for="PreferredName"/>
							<label asp-for="PreferredName">Preferred Name</label>
							<span asp-validation-for="PreferredName" class="text-danger"></span>
						</div>
					
						<div class="inputbox">
							<span class="glyphicon glyphicon-registration-mark" title="Required" aria-hidden="true"></span>
							<input asp-for="LastName"/>
							<label asp-for="LastName">Last Name</label>
							<span asp-validation-for="LastName" class="text-danger"></span>
						</div>
						
						<div class="inputbox">
							<span class="glyphicon glyphicon-registration-mark" title="Required" aria-hidden="true"></span>
							<input asp-for="Email"/>
							<label asp-for="Email">Email Address</label>
							<span asp-validation-for="Email" class="text-danger"></span>
						</div>
						
						<div class="inputbox">
							<input asp-for="Phone" />
							<label asp-for="Phone">Mobile Number</label>
							<span asp-validation-for="Phone" class="text-danger"></span>
						</div>
						
						<button type="submit">Register</button>
					</div>
				</div>
			</div>
		</form>

	</section>

	<div class="modal fade" tabindex="-1" id="page-modal">
		<div class="modal-dialog" style="max-width: 600px;">
			<div id="modal-content" class="modal-content">
			</div>
		</div>
	</div>

	<script src="~/lib/jquery/jquery.min.js"></script>
	<partial name="_ValidationScriptsPartial"/>
</body>
</html>
